---
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../config";
import {
  openRoles,
  rolePath,
  applyHref,
  isExternalApply,
  jobPostingJsonLd,
} from "../../careers";

// An ItemList of role URLs, not the postings themselves. Embedding the full
// JobPosting nodes here published every posting at two addresses, this page and
// the role page, which is duplicate-posting territory and bought the listing
// nothing: a list page is not a shape Google reads postings out of. The list
// carries only roles that are genuinely posted, since jobPostingJsonLd returns
// null for a draft and a draft must not reach a job index. See the note on
// Role.posted in src/careers.ts.
const posted = openRoles.filter((r) => jobPostingJsonLd(r));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Careers at copperhead",
  url: new URL("/careers/", site).href,
  ...(posted.length
    ? {
        mainEntity: {
          "@type": "ItemList",
          itemListElement: posted.map((r, i) => ({
            "@type": "ListItem",
            position: i + 1,
            url: new URL(rolePath(r.slug), site).href,
          })),
        },
      }
    : {}),
};
---

<Base
  title="Careers · copperhead"
  description="Open roles at copperhead, an open source agent that designs circuit boards and verifies its own work against KiCad."
  path="/careers/"
  ogImageAlt="Careers at copperhead"
  jsonLd={jsonLd}
>
  <Navbar home={false} />
  <main id="top">
    <article>
      <div class="wrap">
        <header>
          <p class="kind">Careers</p>
          <h1>Work on copperhead</h1>
          <p class="standfirst">
            We are a small team in Bengaluru working at the intersection of AI,
            electronics engineering and open source software.
          </p>
        </header>

        {
          openRoles.length > 0 ? (
            <>
              <h2 class="head">Open roles</h2>
              <ul class="roles">
                {openRoles.map((r) => (
                  <li>
                    <a class="title" href={rolePath(r.slug)}>
                      {r.title}
                    </a>
                    <span class="meta">
                      <span class="accent">{r.discipline}</span>
                      <span>{r.location}</span>
                      <span>{r.workplace}</span>
                      <span>{r.commitment}</span>
                    </span>
                    <a
                      class="apply"
                      href={applyHref(r)}
                      {...(isExternalApply(r)
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      Apply
                    </a>
                  </li>
                ))}

                {/* The open application, as the last row rather than as a role.
                    It is deliberately not an entry in `roles`: it has no
                    responsibilities, nothing to verify and no date, and a
                    fabricated Role would sit one `posted` field away from
                    emitting JobPosting markup for a job that does not exist.
                    Its title is not a link because there is no page behind it,
                    and its tag carries no copper, so it reads as the end of the
                    list rather than as one more opening. */}
                <li class="open-application">
                  <span class="title">Open application</span>
                  <span class="meta">
                    <span />
                    <span>Bengaluru, India</span>
                    <span>On-site</span>
                    <span />
                  </span>
                  <a
                    class="apply"
                    href={applyHref()}
                    {...(isExternalApply()
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    Apply
                  </a>
                </li>
              </ul>
            </>
          ) : (
            /* Not an error state. A team this size is closed to applications
               most of the time, and saying so plainly is better than a page
               that implies a pipeline it does not have. */
            <p class="none">
              There are no open roles right now.
            </p>
          )
        }

      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  article {
    padding-block: 130px 96px;
  }

  header {
    max-width: 62ch;
  }

  .kind {
    margin: 0 0 1.1rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copper);
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
  }

  .standfirst {
    margin: 1.25rem 0 0;
    color: var(--text-dim);
    font-size: 1.2rem;
    line-height: 1.55;
  }

  /* Tracked mono label, the same as the research index uses. */
  .head {
    margin: 3rem 0 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* The first one follows the standfirst rather than another block, and wants
     the wider gap the research index puts above its card list. */
  header + .head {
    margin-top: 3rem;
  }

  /* A table, drawn as a subgrid so the columns line up across rows without
     giving up a real element per row. Each row is title, four mono facts and
     the apply link; the ul owns the column tracks and every li spans them. */
  .roles {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    /* The title takes whatever the facts leave, and never less than a floor
       that keeps a long one to two lines. `start` stops the auto tracks
       stretching into the free space the fr track is meant to take. */
    grid-template-columns: minmax(20ch, 1fr) repeat(4, max-content) max-content;
    justify-content: start;
    border-top: 1px solid var(--hairline);
  }

  .roles li {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: baseline;
    column-gap: 22px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
  }

  /* The four facts sit in the row's own columns on wide screens and collapse
     to one wrapped line beneath the title on narrow ones. */
  .roles .meta {
    display: contents;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }

  .roles .meta span {
    white-space: nowrap;
  }

  .roles .accent {
    color: var(--copper);
  }

  .roles .title {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: none;
    color: inherit;
  }

  a.title:hover {
    color: var(--copper);
  }

  .roles .apply {
    justify-self: end;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--copper);
    text-decoration: none;
    white-space: nowrap;
  }

  .roles .apply::after {
    content: " ↗";
  }

  .roles .apply:hover {
    color: var(--copper-hi);
  }

  .open-application .title {
    color: var(--text-dim);
  }

  .none {
    max-width: 62ch;
    margin: 2rem 0 0;
    color: var(--text-dim);
    line-height: 1.65;
  }

  /* Six columns stop fitting well before the phone breakpoint, so the rows
     stack here: title and apply on the first line, the facts on the second. */
  @media (max-width: 860px) {
    .roles {
      grid-template-columns: minmax(0, 1fr) max-content;
    }

    .roles li {
      row-gap: 6px;
    }

    .roles .apply {
      grid-row: 1;
      grid-column: 2;
    }

    .roles .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 14px;
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .roles .meta span:empty {
      display: none;
    }
  }

  @media (max-width: 720px) {
    article {
      padding-block: 100px 64px;
    }

    .standfirst {
      font-size: 1.05rem;
    }

    .roles li {
      padding: 12px 0;
    }
  }
</style>
