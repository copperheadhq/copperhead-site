---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import RunDemo from "../components/RunDemo.astro";
import Proof from "../components/Proof.astro";
import Demo from "../components/Demo.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import PricingTiers from "../components/PricingTiers.astro";
import Faq from "../components/Faq.astro";
import { groups, stripTags } from "../faq";

// Sections share the page colour and are told apart by a hairline: each one
// starts on the same 1px rule the footer's top edge draws. Demo only
// renders once public/copperhead-demo.mp4 exists; RunDemo, directly under the
// hero, carries the animated terminal until then and after.

// The FAQ section's questions, as FAQPage data. The same slice Faq.astro
// shows (the first two of each group), so the node never lists a question
// that is not on the page.
const faqJsonLd = {
  "@type": "FAQPage",
  mainEntity: groups
    .flatMap((g) => g.items.slice(0, 2))
    .map((i) => ({
      "@type": "Question",
      name: i.q,
      acceptedAnswer: { "@type": "Answer", text: stripTags(i.a) },
    })),
};
---

<Base jsonLd={faqJsonLd}>
  <Navbar />
  <main>
    <Hero />
    <RunDemo />
    <Proof />
    <Demo />
    <Features />
    <PricingTiers id="pricing" />
    <Faq />
  </main>
  <Footer />
</Base>

<style>
  /* A rule needs air on both sides of it, so every section keeps both
     paddings, cut to 70% so two of them meeting do not open a 272px gap. The
     hero keeps its own: its dot field ends at its bottom edge. */
  main > :global(section:not(.hero)) {
    padding-block: calc(var(--pad-y) * 0.7);
    border-top: 1px solid var(--hairline);
  }
</style>
