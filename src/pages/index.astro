---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Proof from "../components/Proof.astro";
import Demo from "../components/Demo.astro";
import Features from "../components/Features.astro";
import CtaEnd from "../components/CtaEnd.astro";
import Footer from "../components/Footer.astro";
import PricingTiers from "../components/PricingTiers.astro";
import Faq from "../components/Faq.astro";

// Sections share the page colour and are told apart by a hairline: each one
// starts on the same 1px rule the footer's top edge draws. Demo only
// renders once public/copperhead-demo.mp4 exists — the hero already carries
// the animated terminal.
---

<Base>
  <Navbar />
  <main>
    <Hero />
    <Proof />
    <Demo />
    <Features />
    <PricingTiers id="pricing" />
    <Faq />
    <CtaEnd />
  </main>
  <Footer />
</Base>

<style>
  /* A rule needs air on both sides of it, so every section keeps both
     paddings, cut to 70% so two of them meeting do not open a 272px gap. The
     hero keeps its own: its dot field ends at its bottom edge. */
  main > :global(section:not(.hero)) {
    padding-block: calc(var(--pad-y) * 0.7);
    border-top: 1px solid var(--hairline);
  }
</style>
