---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { formatDate } from "../blog";
import { builtPages, placeholders } from "../signoff";

// Every entry in the pages collection, at the path it names. A rest route at
// the root, but it only generates the paths getStaticPaths lists, so it shadows
// nothing: an unknown URL still falls through to 404.astro. Which entries are
// listed is src/signoff.ts's call.
export async function getStaticPaths() {
  const pages = await builtPages();
  return pages.map((page) => ({ params: { path: page.data.path.slice(1, -1) }, props: { page } }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const contents = headings.filter((h) => h.depth === 2);
const open = page.data.draft ? placeholders(page.body ?? "") : [];
---

<Base
  title={`${page.data.title} · Copperhead`}
  description={page.data.description}
  path={page.data.path}
  ogImageAlt={page.data.title}
  noindex={page.data.draft}
>
  <Navbar home={false} />
  <main id="top">
    <article>
      <div class="wrap">
        <header>
          <span class="kind">{page.data.kind}</span>
          <h1>{page.data.title}</h1>
          <p class="updated">Updated {formatDate(page.data.updated)}</p>
        </header>

        {/* Only a draft gets here, and only in `astro dev`: production builds
            leave drafts out entirely. So this is a reviewer's note, not copy. */}
        {
          page.data.draft && (
            <aside class="draft" aria-label="Draft status">
              <p>
                <strong>Draft.</strong> Built by <code>astro dev</code> only and left out of production builds until <code>draft</code> is set to false in <code>src/content/pages/{page.id}.md</code>.
                {page.data.source && (
                  <>
                    {" "}The master is <code>{page.data.source}</code>; edit it there and re-run <code>node scripts/sync-pages.mjs</code>.
                  </>
                )}
              </p>
              {open.length > 0 && (
                <details>
                  <summary>
                    {open.length} bracketed placeholder{open.length === 1 ? "" : "s"} to resolve first
                  </summary>
                  <ol>
                    {open.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ol>
                </details>
              )}
            </aside>
          )
        }

        <div class="layout">
          {
            contents.length > 2 && (
              <nav class="toc" aria-label="Contents">
                <span class="kind">Contents</span>
                <ol>
                  {contents.map((h) => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div class="prose">
            <Content />
          </div>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  article {
    padding-block: 130px 96px;
  }

  header {
    max-width: 62ch;
  }

  .kind {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--copper);
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
  }

  .updated {
    margin: 1rem 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .draft {
    margin-top: 2rem;
    max-width: 78ch;
    padding: 16px 18px;
    border: 2px dashed var(--trace);
    background: var(--panel);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .draft p {
    margin: 0;
  }

  .draft code {
    font-family: var(--mono);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }

  .draft details {
    margin-top: 10px;
  }

  .draft summary {
    cursor: pointer;
    color: var(--copper);
  }

  .draft ol {
    margin: 10px 0 0;
    padding-left: 1.5rem;
    color: var(--text-dim);
  }

  /* Contents beside the text on a wide screen; above it on anything
     narrower. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 46rem);
    gap: 64px;
    margin-top: 56px;
    padding-top: 48px;
    border-top: 1px solid var(--hairline);
  }

  .layout:not(:has(.toc)) {
    grid-template-columns: minmax(0, 46rem);
  }

  .toc {
    align-self: start;
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    max-height: calc(100vh - var(--nav-h) - 64px);
    overflow-y: auto;
  }

  .toc .kind {
    color: var(--text-dim);
  }

  .toc ol {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .toc a {
    display: block;
    padding: 5px 0 5px 12px;
    border-left: 1px solid var(--line);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--text-dim);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--text);
    border-left-color: var(--copper);
  }

  /* Running text in --body, the blog's face for prose. */
  .prose {
    min-width: 0;
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.35rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(h2) {
    margin: 3rem 0 1rem;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
  }

  .prose :global(strong) {
    font-weight: 500;
  }

  .prose :global(a) {
    color: var(--copper);
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--copper-hi);
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
  }

  /* A table scrolls inside its own box on a phone rather than pushing the
     page sideways. */
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    margin: 0 0 1.5rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    vertical-align: top;
    min-width: 9rem;
  }

  .prose :global(th) {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    border-bottom-color: var(--line);
  }

  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .toc {
      position: static;
      max-height: none;
    }
  }

  @media (max-width: 720px) {
    article {
      padding-block: 100px 64px;
    }

    .prose {
      font-size: 1rem;
    }
  }
</style>
