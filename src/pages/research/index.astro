---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../config";
import { readingTime, kindSlug } from "../../blog";
import { articlePath, authorsOf } from "../../research";

const articles = (await getCollection("research")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// The blog index's shape (blog/index.astro), card for card: the newest article
// large at the top, every article in the grid below it, the same PostCard for
// both. A paper's card is a crop of its first page rather than a rendered title
// card, which is the only thing that differs.
const entries = articles.map((a) => ({
  href: articlePath(a.id),
  title: a.data.title,
  description: a.data.description,
  kind: a.data.kind,
  date: a.data.date,
  cover: a.data.cover,
  coverAlt: a.data.coverAlt,
  author: authorsOf(a)
    .map((p) => p.name)
    .join(", "),
  minutes: readingTime(a.body ?? ""),
}));

const [featured] = entries;

// Filter chips, derived from the kinds as the blog's are, so an article that
// introduces a new kind gets its chip without anyone adding one.
const counts = new Map<string, number>();
for (const e of entries) counts.set(e.kind, (counts.get(e.kind) ?? 0) + 1);
const kinds = [...counts.entries()].map(([kind, n]) => ({
  kind,
  n,
  slug: kindSlug(kind),
}));

// ScholarlyArticle rather than TechArticle: the article page says the same, and
// the two should not describe one piece as two different kinds of thing.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "copperhead research",
  url: new URL("/research/", site).href,
  hasPart: articles.map((a) => ({
    "@type": "ScholarlyArticle",
    headline: a.data.title,
    description: a.data.description,
    datePublished: a.data.date.toISOString(),
    url: new URL(articlePath(a.id), site).href,
    author: authorsOf(a).map((p) => ({ "@type": "Person", name: p.name })),
  })),
};
---

<Base
  title="Research · copperhead"
  description="Method and measurement from copperhead, each article tied to the paper, code or data it rests on so the numbers can be reproduced and argued with."
  path="/research/"
  jsonLd={jsonLd}
>
  <Navbar home={false} />
  <main id="top">
    <div class="rs-frame">
      <header class="rs-head">
        <h1 class="rs-h1">Research</h1>

        <div class="rs-cats" role="group" aria-label="Filter articles by kind">
          <button
            type="button"
            class="rs-cat rs-cat-active"
            data-filter="all"
            aria-pressed="true"
          >
            All
          </button>
          {
            kinds.map((k) => (
              <button
                type="button"
                class="rs-cat"
                data-filter={k.slug}
                aria-pressed="false"
              >
                {k.kind}
                <span class="rs-cat-n">{k.n}</span>
              </button>
            ))
          }
        </div>
      </header>

      {
        featured && (
          <section class="rs-feature">
            <PostCard {...featured} large />
          </section>
        )
      }

      <section class="rs-rest">
        <div class="rs-grid">
          {entries.map((e, i) => <PostCard {...e} featured={i === 0} />)}
        </div>
        <p class="rs-empty" hidden>Nothing filed under that yet.</p>
      </section>
    </div>
  </main>
  <Footer />
</Base>

<script>
  /* Filter chips, on the blog index's rule (blog/index.astro): the grid holds
     every article including the featured one, which stays hidden while the
     chip reads "All" and comes back when a filter runs. The kind is mirrored
     into the hash so a filtered view can be linked to. */
  const chips = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
  ];
  const grid = document.querySelector<HTMLElement>(".rs-grid");
  const feature = document.querySelector<HTMLElement>(".rs-feature");
  const empty = document.querySelector<HTMLElement>(".rs-empty");
  const cards = [...document.querySelectorAll<HTMLElement>(".rs-grid .post-card")];

  function apply(tag: string, push = true) {
    const all = tag === "all";
    let shown = 0;

    for (const card of cards) {
      const match = all
        ? !card.hasAttribute("data-featured")
        : card.dataset.kind === tag;
      card.toggleAttribute("hidden", !match);
      if (match) shown++;
    }

    grid?.classList.toggle("filtered", !all);
    feature?.toggleAttribute("hidden", !all);
    // Under "All" an empty grid means one article, already shown large above.
    empty?.toggleAttribute("hidden", all || shown > 0);

    for (const chip of chips) {
      const on = chip.dataset.filter === tag;
      chip.classList.toggle("rs-cat-active", on);
      chip.setAttribute("aria-pressed", String(on));
    }

    if (push) {
      const url = all ? location.pathname : `${location.pathname}#${tag}`;
      history.replaceState(null, "", url);
    }
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => apply(chip.dataset.filter!));
  }

  const initial = location.hash.slice(1);
  if (initial && chips.some((c) => c.dataset.filter === initial))
    apply(initial, false);
</script>

<style>
  /* The bar is fixed, so the frame has to reserve its own clearance. */
  main {
    padding-top: calc(var(--nav-h) + 1px);
  }

  /* The blog index's frame: hairlines down both edges of the content box and
     the dot field behind it, so header, featured article and grid read as
     cells of one sheet. */
  .rs-frame {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    border-inline: 1px solid var(--line);
    background-image: radial-gradient(var(--hairline) 1px, transparent 1px);
    background-position: top center;
    background-size: 22px 22px;
  }

  .rs-head {
    padding: 64px 32px 40px;
    border-bottom: 1px solid var(--line);
  }

  .rs-h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  /* ---- Filter chips ---- */

  .rs-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .rs-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    background: var(--panel);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dim);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }

  .rs-cat:hover {
    border-color: var(--line-hi);
    color: var(--text);
  }

  .rs-cat:active {
    transform: scale(0.97);
  }

  .rs-cat-active,
  .rs-cat-active:hover {
    background: var(--copper);
    border-color: var(--copper);
    color: var(--on-copper);
  }

  .rs-cat-n {
    color: color-mix(in srgb, var(--text-dim) 75%, transparent);
  }

  .rs-cat-active .rs-cat-n {
    color: color-mix(in srgb, var(--on-copper) 70%, transparent);
  }

  /* ---- The list ---- */

  .rs-feature {
    padding: 40px 32px;
    border-bottom: 1px solid var(--line);
  }

  .rs-rest {
    padding: 40px 32px 56px;
  }

  /* With one article the grid holds only the featured card, hidden, and the
     cell would stand there padded and empty under it. */
  .rs-rest:not(:has(.post-card:not([data-featured]))):not(:has(.filtered)) {
    display: none;
  }

  .rs-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* The featured article's own grid cell: dead weight until a filter runs, at
     which point the large card above is hidden and this one takes over. */
  .rs-grid :global(.post-card[data-featured]) {
    display: none;
  }

  /* :not([hidden]) is load-bearing, as on the blog index: without it a filter
     the featured article does not match still paints it. */
  .rs-grid.filtered :global(.post-card[data-featured]:not([hidden])) {
    display: flex;
  }

  .rs-grid :global(.post-card[hidden]) {
    display: none;
  }

  .rs-empty {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  /* section is padded by the global rule; these are cells of a frame. */
  section {
    padding-block: 0;
  }

  @media (max-width: 1024px) {
    .rs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Below this the column is the viewport, where the edge hairlines read as a
     browser artefact rather than as a frame. */
  @media (max-width: 900px) {
    .rs-frame {
      border-inline: 0;
    }
  }

  @media (max-width: 640px) {
    .rs-grid {
      grid-template-columns: 1fr;
    }

    .rs-head {
      padding: 48px 20px 32px;
    }

    .rs-feature {
      padding: 28px 20px;
    }

    .rs-rest {
      padding: 28px 20px 44px;
    }
  }
</style>
