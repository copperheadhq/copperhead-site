---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { site, links } from '../../config';
import { postPath, formatDate } from '../../blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = postPath(post.id);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url: new URL(path, site).href,
  mainEntityOfPage: new URL(path, site).href,
  author: { '@type': 'Organization', name: 'Chouhan Industries', url: links.chouhan },
  publisher: { '@type': 'Organization', name: 'Chouhan Industries', url: links.chouhan },
};
---

<Base
  title={`copperhead: ${post.data.title}`}
  description={post.data.description}
  path={path}
  ogType="article"
  ogImage={post.data.ogImage}
  ogImageAlt={post.data.ogImageAlt}
  publishedTime={post.data.date.toISOString()}
  jsonLd={jsonLd}
>
  <Navbar home={false} />
  <main id="top">
    <article>
      <div class="wrap">
        <header>
          <div class="meta">
            <span class="kind">{post.data.kind}</span>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </div>
          <h1>{post.data.title}</h1>
          <p class="standfirst">{post.data.description}</p>
        </header>

        <div class="prose">
          <Content />
        </div>

        <footer class="end">
          <a href="/blog/">All posts</a>
          <a href={links.repo}>View on GitHub</a>
        </footer>
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  article {
    padding-block: 179px var(--pad-y);
  }

  /* Measure is set on the column, not on each element, so code blocks and the
     output table line up with the paragraphs instead of running wide. */
  .wrap {
    max-width: 760px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
  }

  .kind {
    color: var(--copper);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    text-wrap: balance;
  }

  .standfirst {
    color: var(--text-dim);
    font-size: 1.12rem;
    margin: 1.5rem 0 0;
    max-width: 58ch;
  }

  .prose {
    margin-top: 3.5rem;
    border-top: 1px solid var(--hairline);
    padding-top: 3.5rem;
  }

  .prose :global(p) {
    margin: 0 0 1.4rem;
  }

  /* A paragraph that is one italic run is this blog's caption convention:
     set it like a figcaption, snug under the figure it annotates. */
  .prose :global(p:has(> em:only-child)) {
    margin: 0 0 2.4rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 3.25rem 0 1.25rem;
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin: 2.5rem 0 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.4rem;
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.6rem;
  }

  .prose :global(li)::marker {
    color: var(--copper);
    font-family: var(--mono);
    font-size: 0.85em;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  /* A file shown as itself (FileBlock.astro) and the quickstart terminal
     (InstallBlock.astro) sit in the prose rhythm; each carries its own frame
     and internal metrics. */
  .prose :global(.filefig),
  .prose :global(.terminal) {
    margin: 0 0 1.4rem;
  }

  /* The terminal window (TerminalDemo.astro) asserts margin: 0 auto for its
     hero placement; in the prose it needs the rhythm's bottom margin so a
     caption under it gets the same gap as one under an image. */
  .prose :global(figure.term) {
    margin-bottom: 1.4rem;
  }

  /* Terminal block, on the quickstart's exact metrics (InstallBlock.astro):
     the dashed ink border, 20px 22px padding, 1.75 leading, and the 13px
     phone step. One code surface across the site, not two near-misses.
     Direct child only: the pre inside FileBlock's figure carries that
     component's own metrics and must not pick up a second frame. */
  .prose > :global(pre) {
    background: var(--surface);
    border: 1px dashed color-mix(in srgb, var(--text) 20%, transparent);
    padding: 20px 22px;
    margin: 0 0 1.4rem;
    overflow-x: auto;
    line-height: 1.75;
  }

  /* Shiki dual-theme tokens (defaultColor off in astro.config): each span
     carries both palettes as custom properties, resolved here against the
     color-scheme the theme toggle sets. Same rule as FileBlock.astro. */
  .prose > :global(pre span) {
    color: light-dark(var(--shiki-light), var(--shiki-dark));
  }

  @media (max-width: 720px) {
    .prose > :global(pre) {
      padding: 18px 16px;
    }

    .prose > :global(pre code) {
      font-size: 0.8125rem; /* 13px, the quickstart's phone size */
    }
  }

  .prose :global(:not(pre) > code) {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 0.1em 0.4em;
    font-size: 0.85em;
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    margin: 0 0 1.4rem;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.4rem;
    font-size: 0.94rem;
  }

  .prose :global(th) {
    text-align: left;
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 0 1rem 0.75rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .prose :global(td) {
    padding: 0.85rem 1rem 0.85rem 0;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }

  .prose :global(td:first-child) {
    color: var(--text);
    white-space: nowrap;
  }

  .prose :global(td:last-child) {
    color: var(--text-dim);
  }

  /* Big screens. 760px at 17px is already around 80 characters a line, so
     widening the column on its own would push the measure past comfortable
     rather than improve it. Width and type scale move together instead: 18px in
     an 800px column is the same line length as 17px in 760, on a page that no
     longer looks marooned in the middle of a large display. */
  @media (min-width: 1200px) {
    .wrap {
      max-width: 800px;
    }

    .prose {
      font-size: 1.125rem;
    }
  }

  /* Tables can still exceed the measure on a phone; let this one scroll rather
     than forcing the page body sideways. The first column also gives up its
     nowrap, which keeps most tables from needing to scroll at all. */
  @media (max-width: 720px) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
      font-size: 0.9rem;
    }

    .prose :global(td:first-child) {
      white-space: normal;
    }

    .prose :global(td) {
      padding-right: 0.85rem;
      min-width: 5rem;
    }
  }

  .end {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  @media (max-width: 720px) {
    article {
      padding-block: 139px var(--pad-y);
    }

    .prose {
      margin-top: 2.5rem;
      padding-top: 2.5rem;
    }

    .standfirst {
      font-size: 1.05rem;
    }
  }
</style>
