---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getImage } from 'astro:assets';
import { site, links } from '../../config';
import { groups, stripTags } from '../../faq';
import { coverArt, faqCover } from '../../blog';

// Questions and answers come from src/faq.ts, which the homepage's short FAQ
// section reads too.

// This page is listed on the blog index with a rendered title card of its own
// (index.astro's `faq` entry), so it unfurls that card rather than the site
// card, on the posts' rule: light half, 1200x630, the size Base.astro declares.
const art = coverArt(faqCover.cover);
const ogImage = (
  await getImage({ src: art.light, width: 1200, height: 630, format: 'png' })
).src;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: new URL('/blog/faq/', site).href,
  image: new URL(ogImage, site).href,
  mainEntity: groups.flatMap((g) =>
    g.items.map((i) => ({
      '@type': 'Question',
      name: i.q,
      acceptedAnswer: { '@type': 'Answer', text: stripTags(i.a) },
    })),
  ),
};
---

<Base
  title="copperhead: FAQ"
  description="What copperhead costs, what it refuses to do, whether it replaces an engineer, and what happens to your design files."
  path="/blog/faq/"
  ogImage={ogImage}
  ogImageAlt={faqCover.alt}
  jsonLd={jsonLd}
>
  <Navbar home={false} />
  <main id="top">
    <article>
      <div class="wrap">
        <header>
          <p class="kind">FAQ</p>
          <h1>Frequently asked questions</h1>
          <p class="standfirst">
            The questions hardware engineers ask in the first five minutes. If yours
            is not here, the <a href={links.repo}>repo</a> is the best place to ask.
          </p>
        </header>

        {
          groups.map((g) => (
            <section class="group">
              <h2>{g.title}</h2>
              <div class="items">
                {g.items.map((i) => (
                  <details>
                    <summary>{i.q}</summary>
                    <div class="answer">
                      <p set:html={i.a} />
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }

        <footer class="end">
          <a href="/blog/">All posts</a>
          <a href={links.repo}>View on GitHub</a>
        </footer>
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  article {
    padding-block: 179px var(--pad-y);
  }

  .wrap {
    max-width: 760px;
  }

  .kind {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--copper);
    margin: 0 0 1.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    text-wrap: balance;
  }

  .standfirst {
    color: var(--text-dim);
    font-size: 1.12rem;
    margin: 1.5rem 0 0;
    max-width: 58ch;
  }

  .group {
    padding: 0;
    margin-top: 4rem;
  }

  .group h2 {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
  }

  .items {
    border-top: 1px solid var(--hairline);
  }

  details {
    border-bottom: 1px solid var(--hairline);
  }

  summary {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.15rem 0;
    cursor: pointer;
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.4;
    letter-spacing: -0.015em;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Copper plus/minus drawn from text so it needs no icon asset. */
  summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--copper);
    line-height: 1;
  }

  details[open] summary::after {
    content: '\2212';
  }

  summary:hover {
    color: var(--copper-hi);
  }

  .answer {
    padding: 0 3rem 1.5rem 0;
  }

  .answer :global(p) {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.99rem;
  }

  .end {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  @media (max-width: 720px) {
    article {
      padding-block: 139px var(--pad-y);
    }

    .standfirst {
      font-size: 1.05rem;
    }

    .group {
      margin-top: 3rem;
    }

    summary {
      font-size: 1rem;
      padding-block: 1.1rem;
    }

    .answer {
      padding-right: 1.5rem;
    }
  }
</style>
