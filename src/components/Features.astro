---
// "How it works": the create pipeline, built in markup rather than embedded as
// a picture. It is the same content as the social card (diagrams/social-flow.html,
// which the blog embeds through StageFlow.astro), rebuilt so it reflows: a brief
// goes in, eight gated stages run, a design package comes out.
//
// One layout at every width. The pads and the stage grid stack vertically and
// the copper via between them is the same element on a phone as on a desktop;
// only the grid changes, 4 columns to 2 to 1, on the card system's own
// breakpoints. Nothing is positioned absolutely except the IN and OUT tags.
const stages = [
  {
    n: '01',
    name: 'spec',
    artifact: 'docs/SPEC.md',
    gate: 'a budgets section with numbers in it',
  },
  {
    n: '02',
    name: 'architecture',
    artifact: 'docs/SUBSYSTEMS.md',
    gate: 'a written rationale under every subsystem',
  },
  {
    n: '03',
    name: 'parts',
    artifact: 'docs/BOM.md',
    gate: 'part numbers chosen against datasheets',
  },
  {
    n: '04',
    name: 'schematic',
    artifact: 'design.kicad_sch',
    gate: 'symbols placed, docs agree, ERC clean',
    // KiCad checks this stage itself, so it carries the copper ring
    verified: true,
  },
  {
    n: '05',
    name: 'layout',
    artifact: 'design.kicad_pcb',
    gate: 'footprints on the board, DRC clean',
    verified: true,
  },
  {
    n: '06',
    name: 'outputs',
    artifact: 'gerbers / drill / STEP',
    gate: 'gerber files on disk',
  },
  {
    n: '07',
    name: 'firmware',
    artifact: 'firmware/ / pins.h',
    gate: 'sources on disk, pins from the pinout',
  },
  {
    n: '08',
    name: 'dev plan',
    artifact: 'docs/DEVPLAN.md',
    gate: 'a written bring-up and test plan',
  },
];
---

<section id="features">
  <div class="wrap">
    <h2 class="section-title">Eight stages, start to finish.</h2>
    <p class="section-intro">
      You write the brief. copperhead runs the stages in order, each one its
      own agent run. A stage has to leave its artifact on disk before the next
      starts. If a gate fails, the run stops there.
    </p>

    <div class="pipeline">
      <div class="pad">
        <span class="tag">in</span>
        <p class="padname"><code>brief.md</code></p>
        <p class="padsub">what you want, written in your own words</p>
      </div>

      <div class="hop"></div>

      <ol class="stages">
        {
          stages.map((s) => (
            <li class:list={['stage', { verified: s.verified }]}>
              <span class="num">{s.n}</span>
              <h3>{s.name}</h3>
              <p class="artifact">
                <code>{s.artifact}</code>
              </p>
              <p class="gate">
                <span class="g">gate</span>
                {s.gate}
              </p>
            </li>
          ))
        }
      </ol>

      <div class="hop"></div>

      <div class="pad">
        <span class="tag">out</span>
        <p class="padname">a design package</p>
        <p class="padsub">gerbers, firmware, docs. One commit per stage.</p>
      </div>
    </div>

    <ul class="legend">
      <li>
        <span class="mark via"></span>
        <span>Every hop is a gate: <b>a stage commits only once its artifact is on disk</b>.</span>
      </li>
      <li>
        <span class="mark ring"></span>
        <span>Copper border: <b>KiCad checks this stage, ERC or DRC clean</b>.</span>
      </li>
    </ul>

    <!-- The arrow is drawn rather than set as a glyph, on Hero.astro's rule:
         the font subsets do not carry it. -->
    <a class="readmore" href="/blog/from-brief-to-gerbers">
      Read the stage-by-stage walkthrough<svg
        class="arrow"
        viewBox="0 0 16 16"
        width="13"
        height="13"
        aria-hidden="true"
        focusable="false"
        ><path
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg
      >
    </a>
  </div>
</section>

<style>
  /* The title is one sentence, so it gets one line. The shared 20ch cap breaks
     it in two; dropping the cap here rather than raising it leaves narrow
     viewports to wrap on the container as before. */
  .section-title {
    max-width: none;
  }

  .pipeline {
    margin-top: 3.25rem;
  }

  /* ---- the two end pads ---- */
  .pad {
    position: relative;
    max-width: 470px;
    margin-inline: auto;
    background: color-mix(in srgb, var(--copper) 7%, var(--bg));
    border: 1.5px solid var(--copper);
    padding: 22px 24px 20px;
  }

  .tag {
    position: absolute;
    top: -11px;
    left: 22px;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-copper);
    background: var(--copper);
    padding: 3px 9px;
  }

  .padname {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .padname code {
    font-family: var(--mono);
    font-size: 1rem;
  }

  .padsub {
    margin: 0.5rem 0 0;
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* ---- the via between a pad and the grid: one copper trace, one drilled
     hole. Same element at every width, which is what keeps the phone layout
     from needing a second idea. ---- */
  .hop {
    position: relative;
    height: 38px;
  }

  .hop::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--trace);
  }

  .hop::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 9px;
    transform: translate(-50%, -50%);
    border: 1.5px solid var(--copper);
    border-radius: 50%;
    background: var(--bg);
  }

  /* ---- the eight stages, on the site's card system: a 2px hairline frame
     with page-white cells divided by 1px gutters of the same tone ---- */
  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 2px solid var(--line);
  }

  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    padding: 26px 24px 24px;
    transition: background-color 0.16s ease;
  }

  .stage:hover {
    background: var(--panel);
  }

  /* the ring is drawn inside the cell, so a verified stage cannot nudge the
     grid by 1.5px */
  .stage.verified::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--copper);
    pointer-events: none;
  }

  .num {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--copper);
  }

  .stage h3 {
    margin: 0.45rem 0 0;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .artifact {
    margin: 0.75rem 0 1.15rem;
  }

  .artifact code {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 4px 8px;
    /* the longest chip is docs/SUBSYSTEMS.md; let it wrap rather than push the
       column out on a narrow phone */
    overflow-wrap: anywhere;
  }

  .gate {
    margin: 1.4rem 0 0;
    /* pins the gate to the bottom of the tallest cell in the row */
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    color: var(--text-dim);
    font-size: 0.875rem;
    line-height: 1.45;
    min-height: calc(0.85rem + 2.9em);
  }

  .gate .g {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copper);
    margin-right: 7px;
  }

  /* ---- legend ---- */
  .legend {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.25rem;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .legend li {
    display: flex;
    /* start, not center: the marker sits on the first line when the sentence
       wraps, which it does on a phone */
    align-items: flex-start;
    gap: 0.6rem;
  }

  .legend b {
    color: var(--text);
    font-weight: 500;
  }

  .mark {
    flex: none;
    margin-top: 0.3em;
    width: 11px;
    height: 11px;
    border: 1.5px solid var(--copper);
  }

  .mark.via {
    border-radius: 50%;
  }

  /* The one link out of this section, so it is an action rather than a word
     inside a sentence: copper, on its own line, with the arrow stepping
     forward on hover. */
  .readmore {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.15rem;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--trace);
    color: var(--copper);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }

  .readmore:hover {
    color: var(--copper-hi);
    border-bottom-color: var(--copper);
  }

  .readmore .arrow {
    flex: none;
    transition: transform 0.16s ease;
  }

  .readmore:hover .arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .readmore .arrow {
      transition: none;
    }
  }

  @media (max-width: 940px) {
    .stages {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .pipeline {
      margin-top: 2.25rem;
    }

    .stages {
      grid-template-columns: 1fr;
    }

    /* Stacked, a card has the whole width and only one thing to say, so it
       stops being a card and becomes a row: the number, the name and the file
       on one line, the gate under them. Roughly half the height of the
       column-per-card version, which is what makes eight of them scrollable. */
    .stage {
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'num name file'
        'gate gate gate';
      align-items: baseline;
      column-gap: 0.55rem;
      row-gap: 0.45rem;
      padding: 15px 16px 16px;
    }

    .num {
      grid-area: num;
      font-size: 0.7rem;
    }

    .stage h3 {
      grid-area: name;
      margin: 0;
      font-size: 1.05rem;
    }

    .artifact {
      grid-area: file;
      margin: 0;
      justify-self: end;
      /* the row is baseline-aligned; the chip's border would otherwise sit
         half a line low next to the name */
      align-self: center;
    }

    .artifact code {
      font-size: 0.68rem;
      padding: 3px 6px;
    }

    /* the head row already separates it, so the rule and its padding go */
    .gate {
      grid-area: gate;
      margin: 0;
      padding: 0;
      border: 0;
      min-height: 0;
      font-size: 0.82rem;
      line-height: 1.4;
    }

    .hop {
      height: 26px;
    }

    .pad {
      padding: 17px 16px 16px;
    }

    .padname {
      font-size: 1.02rem;
    }

    .padname code {
      font-size: 0.92rem;
    }

    .padsub {
      margin-top: 0.35rem;
      font-size: 0.88rem;
    }

    .legend {
      margin-top: 1.25rem;
      gap: 0.5rem 1.5rem;
      font-size: 0.82rem;
    }

    .readmore {
      margin-top: 1rem;
      font-size: 0.95rem;
    }
  }

</style>
