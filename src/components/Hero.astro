---
import Backers from "./Backers.astro";
import { getCollection } from "astro:content";
import { postPath } from "../blog";
import { articlePath } from "../research";
import { links } from "../config";

// One centred column with a prompt panel in the middle of it, and the backer
// strip across the foot of the fold:
//
//   ┌──────────────────────────────────────────────────────┐
//   │                       chip                           │
//   │                     headline                         │
//   │                      subhead                         │
//   │        ┌──────────────────────────────────┐          │
//   │        │ Describe the board you want... (^) │          │
//   │        └──────────────────────────────────┘          │
//   ├──────────────────────────────────────────────────────┤
//   │            BACKED BY   ← logos rolling →             │
//   └──────────────────────────────────────────────────────┘
//
// The panel is the product's front door, drawn after the prompt in the cloud
// app (copperhead-cloud, components/chat/composer.tsx): a rounded box with the
// field and the send arrow on one row, the arrow centred down the right side,
// so on one line the text and the arrow sit in the middle of the box together.
//
// Only the arrow. The app's box also has + (files, Think longer, Search the
// web), / (commands) and the model's name. They were tried here twice: first
// as icons that opened the app, then as cards that explained them. Both were
// taken out. The features only work in the app, and a copy of them here would
// have to be kept in step with it by hand. The visitor meets them a moment
// later, in the app's own box.
//
// It is the door to the app's guest chat (app.copperhead.sh/new), where a
// visitor with no account talks the brief through with the model and signs in
// only to build. The visitor types here, and the build arrow (or Enter) takes
// what they typed there, with the page fading out on the way (the script
// below). The text goes along in the URL fragment. For a visitor with no
// account the app sends it as their first message, since they pressed build
// here. A visitor who is already signed in is sent on to the app's own start
// screen with the text in its box. This page cannot tell the two apart and
// does not need to. The textarea has no `name`, so nothing typed ever lands
// in a query string.
//
// The terminal that used to hold the right half of this fold is one section
// down, in RunDemo.astro, with the stats that caption it.
//
// The headline carries the phrase people search for. "Cursor for circuit
// boards" was the h1 before and is now the opening of the subhead: it is a
// good line and it names no search term, so a page led by it was a page about
// nothing a crawler could match.
//
// The "New" chip is read from the collections rather than typed in, which is
// the only way a badge that says "New" stays true. Destructuring an empty
// collection gives undefined, and the chip is guarded on it: the collection is
// empty on a checkout with no posts, and transiently whenever the
// content-layer cache is cleared under a running dev server.
const [latest] = [
  ...(await getCollection("blog")).map((p) => ({
    href: postPath(p.id),
    title: p.data.title,
    date: p.data.date,
  })),
  ...(await getCollection("research")).map((a) => ({
    href: articlePath(a.id),
    title: a.data.title,
    date: a.data.date,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<section id="top" class="hero">
  <!-- The lattice, with the content over it. -->
  <div class="grid-dots" aria-hidden="true"></div>

  <div class="wrap">
    <div class="copy">
      {
        latest && (
          <a class="chip" href={latest.href}>
            <span class="chip-tag">
              <span class="chip-dot" aria-hidden="true" />
              New
            </span>
            <span class="chip-text">
              <span class="chip-title">{latest.title}</span>
              <svg
                class="chip-arrow"
                viewBox="0 0 16 16"
                width="12"
                height="12"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8h9.5M9 4.5 12.5 8 9 11.5"
                />
              </svg>
            </span>
          </a>
        )
      }

      <h1>AI for PCB design<span class="stop">.</span></h1>

      <p class="sub">
        Cursor for circuit boards. Describe the board and Copperhead, an open
        source AI agent, drafts the KiCad schematic, layout and Gerbers.
      </p>

      <div class="stage">
      <form class="panel" action={links.newChat} method="get" data-prompt-form>
        <label class="sr-only" for="hero-prompt">Describe the board you want to build</label>
        <textarea
          id="hero-prompt"
          rows="1"
          maxlength="8000"
          placeholder="Describe the board you want to build"
          autocomplete="off"
          spellcheck="true"></textarea>

        <button type="submit" class="send" aria-label="Build in Copperhead Cloud" title="Build">
          <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true" focusable="false">
            <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M9 14.5v-11M4.5 8 9 3.5 13.5 8"></path>
          </svg>
        </button>
      </form>
      </div>

    </div>
  </div>

  <!-- The foot of the fold. Outside .wrap, so the rail runs the full --maxw box
       and its ends feather against the frame's vertical rules. `flex: none`
       keeps it out of the fight for the fold's slack. -->
  <div class="strip">
    <Backers caption="Backed by" />
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-prompt-form]");
  const field = form?.querySelector<HTMLTextAreaElement>("textarea");

  if (form && field) {
    // The field grows with what is typed into it, up to a ceiling, so a long
    // description is not read through a two-line slot.
    const fit = () => {
      field.style.height = "auto";
      field.style.height = `${Math.min(field.scrollHeight, 220)}px`;
    };
    field.addEventListener("input", fit);

    // The placeholder types itself: a fixed opening, then one prewritten board
    // after another, typed out, held and deleted. It is the placeholder
    // attribute being rewritten, not an overlay, so it disappears the moment
    // the reader types and never has to be kept out of the way of real text.
    // The static sentence in the markup is what a reader with reduced motion
    // (or no script) sees.
    const LEAD = "Ask Copperhead to design ";
    const IDEAS = [
      "a USB-C power breakout with a 3 A fuse",
      "an ESP32 sensor node that sleeps at 50 uA",
      "a palm-size Bluetooth speaker",
      "a CAN bus motor driver for two 3 A motors",
      "a LoRa weather station on a solar cell",
      "a macro pad with twelve keys and USB-C",
    ];
    const TYPE = 42; // ms per character typed
    const ERASE = 18; // per character deleted
    const HOLD = 1900; // a finished line stays this long
    const GAP = 380; // the pause on the bare opening before the next line

    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let idea = 0;
      let shown = 0;
      let erasing = false;

      const tick = () => {
        // Nothing to animate while there is real text in the field or the tab
        // is in the background; look again shortly.
        if (field.value || document.hidden) {
          setTimeout(tick, 400);
          return;
        }

        const text = IDEAS[idea];
        shown += erasing ? -1 : 1;
        field.placeholder = LEAD + text.slice(0, shown);

        let wait = erasing ? ERASE : TYPE;
        if (!erasing && shown === text.length) {
          erasing = true;
          wait = HOLD;
        } else if (erasing && shown === 0) {
          erasing = false;
          idea = (idea + 1) % IDEAS.length;
          wait = GAP;
        }
        setTimeout(tick, wait);
      };

      field.placeholder = LEAD;
      setTimeout(tick, 700);
    }

    // ── The handoff to the app's guest chat. The box is an ordinary text box:
    // the visitor clicks in and types. The build arrow or Enter goes to
    // app.copperhead.sh/new#prompt=<text>, and an empty box keeps them here
    // with the cursor in it. A fragment reaches no server, log or referrer. The
    // app reads it once (lib/guest/prompt.ts in copperhead-cloud) and takes at
    // most 8,000 characters, which is this box's limit too. The form's
    // action is that address, so with no script the arrow still gets there.
    const target = () => {
      const text = field.value.trim();
      return text ? `${form.action}#prompt=${encodeURIComponent(text)}` : form.action;
    };

    // The way out: the app starts loading at once, and while it does the page
    // fades to its background, the colour the app's page opens on, so the
    // switch is a fade rather than a flash. Nothing waits on the fade. If the
    // app takes a moment, a thin copper bar runs along the top so the empty
    // screen reads as loading, not as stuck. The veil stays up until the
    // app's page replaces this one.
    let leaving = false;
    let veil: HTMLElement | null = null;

    const go = () => {
      if (leaving) return;
      leaving = true;
      const href = target();

      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        veil = document.createElement("div");
        veil.className = "handoff";
        veil.setAttribute("aria-hidden", "true");
        veil.innerHTML = '<div class="handoff-loading"></div>';
        document.body.append(veil);
      }

      location.assign(href);
    };

    // Build: there has to be something to build first.
    const build = () => {
      if (field.value.trim()) go();
      else field.focus();
    };

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      build();
    });

    // Enter builds and Shift+Enter breaks the line, as in every chat box.
    field.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        build();
      }
    });

    // Back from the app restores this page from the back/forward cache with
    // the veil still up. Take it down.
    addEventListener("pageshow", (e) => {
      if (!e.persisted) return;
      veil?.remove();
      veil = null;
      leaving = false;
    });
  }
</script>

<style>
  /* The section is the fold: one viewport tall wherever there is room, and a
     floor rather than a fixed height, so a window too short for the stack
     grows and scrolls instead of shearing the backer strip off the bottom.
     A column: the copy takes the slack and centres in it, the strip keeps its
     own height. */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    /* "Clear the bar, then leave a gap": the bar is fixed and the hero cannot
       see it, so a padding stated as a bare svh fraction shrinks toward the
       bar on a short viewport and the chip ends up resting on its rule. */
    padding-block: calc(var(--nav-h) + clamp(24px, 4.6svh, 58px))
      clamp(24px, 6svh, 72px);
    overflow: hidden;
  }

  .hero .wrap {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    /* `safe`, so a stack taller than the fold falls back to top-anchored and
       the headline stays on screen instead of being pushed off the top. */
    justify-content: safe center;
  }

  .copy {
    flex: none;
    min-width: 0;
    text-align: center;
  }

  .strip {
    position: relative;
    flex: none;
    margin-top: clamp(16px, 3.4svh, 2.5rem);
  }

  /* No glow. Two were tried and both came out: one rising from the bottom
     edge, which put a coloured cloud under the backer logos, and one as a
     halo behind the panel, which read as a smudge round a box that is
     otherwise all straight edges. The panel is set off by its frame, its
     shadow and the copper ring it takes on focus, and the fold is flat. */
  .stage {
    width: min(100%, 760px);
    margin: clamp(22px, 4.4svh, 40px) auto 0;
  }

  /* The dot field, rule for rule the one the live site runs: dense along all
     four edges, the bottom included, thinning to almost nothing through the
     middle. A diamond lattice: two dot grids on a 16x11 pitch, the second offset by
     half of each, so every dot's nearest neighbours are on its diagonals and
     the cell reads as a rhombus rather than as offset rows. The soft ramp on
     each dot is antialiasing by hand: a hard-edged radial gradient gets none,
     and at this diameter resolves as a square. */
  .grid-dots {
    --pitch: 16px;
    --rise: 11px;
    /* the ramp's outer edge; the gradient is sized to it so the dot is not
       clipped by its own tile */
    --edge: 1.15px;

    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        circle at var(--edge) var(--edge),
        color-mix(in srgb, var(--copper) 38%, transparent) 0 0.65px,
        transparent var(--edge)
      ),
      radial-gradient(
        circle at var(--edge) var(--edge),
        color-mix(in srgb, var(--copper) 38%, transparent) 0 0.65px,
        transparent var(--edge)
      );
    background-size:
      var(--pitch) var(--rise),
      var(--pitch) var(--rise);
    background-position:
      0 0,
      calc(var(--pitch) / 2) calc(var(--rise) / 2);
    /* The field is a frame: dense along all four edges, thinning inward to
       almost nothing through the middle.

       Two gradients, one per axis, and they are unioned rather than
       intersected — that is the whole thing. `intersect` multiplies, so a pixel
       had to be near the left/right edge *and* low on the page to survive, which
       is why every earlier version was a pair of side bands or a dome rather
       than a border. `add` takes the stronger of the two, so a pixel is dense
       if it is near any edge, the corners get both, and the centre keeps only
       what the two flat middles sum to.

       Those middles are 3% each, so the centre sits at 6% — enough that the
       copy column is not a bare white hole in the field, low enough to read
       every line of type over it.

       The four edges are not equal. Left, right and bottom run to full, but the
       top peaks at 14% and is back to the flat middle by a fifth of the way
       down: it is the edge nearest the navbar's rule and the one the headline
       sits closest to. At full strength it read as a second rule under the
       first, and even at 30% over a band 350px deep it put a wash across the
       whole headline. The corners keep their weight regardless — the
       horizontal gradient is already at full there, and under `add` the
       stronger of the two wins — so the frame still closes at all four corners
       rather than fraying at the top. The transparent sliver above it keeps the
       field off the navbar rule entirely. */
    -webkit-mask-image:
      linear-gradient(
        90deg,
        #000 0%,
        rgba(0, 0, 0, 0.03) 30%,
        rgba(0, 0, 0, 0.03) 70%,
        #000 100%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        rgba(0, 0, 0, 0.14) 4%,
        rgba(0, 0, 0, 0.03) 20%,
        rgba(0, 0, 0, 0.03) 74%,
        #000 100%
      );
    -webkit-mask-composite: source-over;
    mask-image:
      linear-gradient(
        90deg,
        #000 0%,
        rgba(0, 0, 0, 0.03) 30%,
        rgba(0, 0, 0, 0.03) 70%,
        #000 100%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        rgba(0, 0, 0, 0.14) 4%,
        rgba(0, 0, 0, 0.03) 20%,
        rgba(0, 0, 0, 0.03) 74%,
        #000 100%
      );
    mask-composite: add;
  }

  /* ── Announcement chip: 33px tall on a panel fill, a 1px accent-tinted
     frame and two segments. No rule between them: the tag's tinted fill ends
     and that edge reads as the divider. ── */
  .chip {
    display: inline-flex;
    align-items: stretch;
    max-width: 100%;
    height: 33px;
    border: 1px solid color-mix(in srgb, var(--copper) 25%, transparent);
    background: var(--panel);
    font-size: 0.78125rem; /* 12.5px */
    font-weight: 500;
    letter-spacing: -0.005em;
    text-decoration: none;
    text-align: left;
    transition: border-color 0.16s ease;
  }

  .chip:hover {
    border-color: color-mix(in srgb, var(--copper) 45%, transparent);
  }

  .chip-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: color-mix(in srgb, var(--copper) 8%, transparent);
    color: var(--copper);
  }

  /* A 12px outlined square with an 8px filled one inside it, from one
     element: the border and padding inset the content box, and
     background-clip keeps the fill off the padding. */
  .chip-dot {
    width: 12px;
    height: 12px;
    flex: none;
    padding: 1px;
    border: 1px solid color-mix(in srgb, var(--copper) 40%, transparent);
    background: var(--copper);
    background-clip: content-box;
  }

  .chip-text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    color: var(--text);
    /* allowed to shrink below its content, or the title pushes the chip past
       the column instead of truncating */
    min-width: 0;
    overflow: hidden;
  }

  /* The chip is one line by construction and the newest title is whatever it
     is, so it is the title that truncates. */
  .chip-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chip-arrow {
    flex: none;
    opacity: 0.6;
  }

  /* ── Headline. Space Grotesk 500 on 1.04 leading with -0.058em of tracking,
     the display metrics the two-column hero ran. The `min()` adds a height
     term to the usual width clamp, because the headline is the one item on
     the fold that can eat the panel's room on a short window. One line at
     every desktop width: "AI for PCB design." is 18 characters. ── */
  h1 {
    font-size: clamp(2.5rem, min(6.4vw, 10svh), 5.5rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.058em;
    margin: clamp(18px, 3.4svh, 30px) auto 0;
    text-wrap: balance;
  }

  /* the headline ends on a coloured full stop */
  .stop {
    color: var(--copper);
  }

  .sub {
    color: var(--text-dim);
    font-size: 1.1875rem; /* 19px */
    line-height: 1.55;
    letter-spacing: -0.012em;
    max-width: 39em;
    margin: clamp(12px, 2.4svh, 20px) auto 0;
    text-wrap: balance;
  }

  /* ── The panel, to the cloud app's prompt: a 28px pill on the panel fill
     with a stronger hairline, 8px of padding and a 36px round send control
     beside the field. The one rounded box on a square site, on purpose: it is
     the app's control, shown as the app shows it.

     The field and the arrow share one row, the arrow centred down the box's
     right side. On a wide screen the field is one line tall, so the text and
     the arrow sit in the middle together. On a phone the moving placeholder
     needs two to four lines (see the media queries), so the field starts
     that tall rather than cutting it off, and the arrow stays in the middle
     of it. ── */
  .panel {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    background: var(--panel);
    border: 1px solid var(--line-hi);
    border-radius: 28px;
    box-shadow: var(--lift);
    text-align: left;
    transition: border-color 0.16s ease;
  }

  .panel:focus-within {
    border-color: var(--text-dim);
  }

  textarea {
    display: block;
    flex: 1;
    min-width: 0;
    min-height: 48px;
    max-height: 220px;
    padding: 12px 4px 12px 14px;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.5rem;
    resize: none;
    outline: none;
  }

  textarea::placeholder {
    color: var(--text-dim);
    opacity: 1;
  }

  .send {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition:
      color 0.16s ease,
      background-color 0.16s ease;
  }

  /* Neutral until there is something to send, copper once there is. Read off
     the field in CSS, so it needs no script. */
  .send {
    background: color-mix(in srgb, var(--text) 10%, transparent);
    color: var(--text-dim);
  }

  .panel:has(textarea:not(:placeholder-shown)) .send {
    background: var(--copper);
    color: var(--on-copper);
  }

  .panel:has(textarea:not(:placeholder-shown)) .send:hover {
    background: var(--copper-hi);
  }

  /* ── The way out (see the script). A veil in the page's background colour
     fades up over everything, the navbar included, and takes every click
     while the app loads. The script makes it, so it carries no scoped
     attribute and is reached through :global. The loading bar waits before
     it shows, so a quick load never flashes it. ── */
  :global(.handoff) {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--bg);
    animation: handoff-fade 0.26s ease-out both;
  }

  :global(.handoff-loading) {
    position: absolute;
    top: 0;
    left: 0;
    width: 30%;
    height: 2px;
    background: var(--copper);
    opacity: 0;
    animation:
      handoff-show 0.2s ease-out 0.45s forwards,
      handoff-run 1.1s ease-in-out 0.45s infinite;
  }

  @keyframes handoff-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes handoff-show {
    to {
      opacity: 1;
    }
  }

  @keyframes handoff-run {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(340%);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .grid-dots {
      opacity: 0.75;
    }
  }

  /* Phones. Every step above the fold closes up, and the send control grows
     to a 40px thumb target. */
  @media (max-width: 720px) {
    h1 {
      font-size: clamp(2.25rem, 10.4vw, 3rem);
      letter-spacing: -0.045em;
    }

    .sub {
      font-size: 1rem;
      line-height: 1.5;
    }

    .send {
      width: 40px;
      height: 40px;
    }

    /* The longest placeholder ("Ask Copperhead to design an ESP32 sensor
       node that sleeps at 50 uA") measured two lines from 430 to 640px. */
    textarea {
      min-height: 72px;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-block: calc(var(--nav-h) + clamp(12px, 2.6svh, 24px))
        clamp(18px, 4.44svh, 40px);
    }

    .chip {
      height: 28px;
      font-size: 0.6875rem; /* 11px */
    }

    .chip-text {
      padding: 0 8px;
      gap: 6px;
    }
  }

  /* And three lines from 360 to 420px, */
  @media (max-width: 420px) {
    textarea {
      min-height: 96px;
    }
  }

  /* and four at 320px, the narrowest phone still in use. */
  @media (max-width: 350px) {
    textarea {
      min-height: 120px;
    }
  }
</style>
