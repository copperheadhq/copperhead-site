---
import Backers from "./Backers.astro";
import { getCollection } from "astro:content";
import { postPath } from "../blog";
import { articlePath } from "../research";
import { links } from "../config";

// One centred column with a prompt panel in the middle of it, and the backer
// strip across the foot of the fold:
//
//   ┌──────────────────────────────────────────────────────┐
//   │                       chip                           │
//   │                     headline                         │
//   │                      subhead                         │
//   │        ┌──────────────────────────────────┐          │
//   │        │ Describe the board you want... (^) │          │
//   │        └──────────────────────────────────┘          │
//   ├──────────────────────────────────────────────────────┤
//   │            BACKED BY   ← logos rolling →             │
//   └──────────────────────────────────────────────────────┘
//
// The panel is the product's front door, drawn after the prompt in the cloud
// app (copperhead-cloud, components/chat/composer.tsx): a rounded box with the
// field and a "Start building" button on one row, the button centred down the
// right side, so on one line the text and the button sit in the middle of the
// box together. The app's own box sends with a bare arrow, which its users
// know; a first-time visitor here is told in words what the page's one main
// button does. "Start building" rather than "Build" because it starts the
// conversation that finalises the brief, and the build itself comes after
// sign-in, in the app. On a phone the label goes and the button is the round
// arrow, since a labelled button would squeeze the field to a few words a
// line.
//
// Only that button. The app's box also has + (files, Think longer, Search the
// web), / (commands) and the model's name. They were tried here twice: first
// as icons that opened the app, then as cards that explained them. Both were
// taken out. The features only work in the app, and a copy of them here would
// have to be kept in step with it by hand. The visitor meets them a moment
// later, in the app's own box.
//
// It is the door to the app's guest chat (app.copperhead.sh/new), where a
// visitor with no account talks the brief through with the model and signs in
// only to build. The visitor types here, and Start building (or Enter) takes
// what they typed there, with the page fading out on the way (the script
// below). The text goes along in the URL fragment. For a visitor with no
// account the app sends it as their first message, since they pressed build
// here. A visitor who is already signed in is sent on to the app's own start
// screen with the text in its box. This page cannot tell the two apart and
// does not need to. The textarea has no `name`, so nothing typed ever lands
// in a query string. The cost of that is the reader with no script: the
// button still opens the app but the text stays behind. A line under the box
// says so.
//
// The terminal that used to hold the right half of this fold is one section
// down, in RunDemo.astro, with the stats that caption it.
//
// The headline carries the phrase people search for. "Cursor for circuit
// boards" was the h1 before and is now the opening of the subhead: it is a
// good line and it names no search term, so a page led by it was a page about
// nothing a crawler could match.
//
// The "New" chip is read from the collections rather than typed in, which is
// the only way a badge that says "New" stays true. Destructuring an empty
// collection gives undefined, and the chip is guarded on it: the collection is
// empty on a checkout with no posts, and transiently whenever the
// content-layer cache is cleared under a running dev server.
const [latest] = [
  ...(await getCollection("blog")).map((p) => ({
    href: postPath(p.id),
    title: p.data.title,
    date: p.data.date,
  })),
  ...(await getCollection("research")).map((a) => ({
    href: articlePath(a.id),
    title: a.data.title,
    date: a.data.date,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

// What the placeholder types out (see the script): a fixed opening, then one
// board after another. Written into the markup as data rather than kept in the
// script, so the layout audit (scripts/shots.mjs) checks each one against the
// field it is typed into. Plain ASCII: the script sets them as they are, and
// the font subset carries nothing more.
const lead = "Ask Copperhead to design ";
const ideas = [
  "a USB-C power breakout with a 3 A fuse",
  "an ESP32 sensor node that sleeps at 50 uA",
  "a palm-size Bluetooth speaker",
  "a CAN bus motor driver for two 3 A motors",
  "a LoRa weather station on a solar cell",
  "a macro pad with twelve keys and USB-C",
];
---

<section id="top" class="hero">
  <!-- The lattice, with the content over it. -->
  <div class="grid-dots" aria-hidden="true"></div>

  <div class="wrap">
    <div class="copy">
      {
        latest && (
          <a class="chip" href={latest.href}>
            <span class="chip-tag">
              <span class="chip-dot" aria-hidden="true" />
              New
            </span>
            <span class="chip-text">
              <span class="chip-title">{latest.title}</span>
              <svg
                class="chip-arrow"
                viewBox="0 0 16 16"
                width="12"
                height="12"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8h9.5M9 4.5 12.5 8 9 11.5"
                />
              </svg>
            </span>
          </a>
        )
      }

      <h1>AI for PCB design<span class="stop">.</span></h1>

      <p class="sub">
        Cursor for circuit boards. Describe the board and Copperhead, an open
        source AI agent, drafts the KiCad schematic, layout and Gerbers.
      </p>

      <div class="stage">
        <form class="panel" action={links.newChat} method="get" data-prompt-form>
          <label class="sr-only" for="hero-prompt">Describe the board you want to build</label>
          <textarea
            id="hero-prompt"
            rows="1"
            maxlength="8000"
            placeholder="Describe the board you want to build"
            data-lead={lead}
            data-ideas={JSON.stringify(ideas)}
            autocomplete="off"
            enterkeyhint="send"
            spellcheck="true"></textarea>

          <button type="submit" class="send" aria-label="Start building in Copperhead Cloud">
            <span class="send-label">Start building</span>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9.5M9 4.5 12.5 8 9 11.5"></path>
            </svg>
          </button>
        </form>

        <noscript>
          <p class="nojs">Your text is carried over only with JavaScript on.</p>
        </noscript>
      </div>

    </div>
  </div>

  <!-- The foot of the fold. Outside .wrap, so the rail runs the full --maxw box
       and its ends feather against the frame's vertical rules. `flex: none`
       keeps it out of the fight for the fold's slack. -->
  <div class="strip">
    <Backers caption="Backed by" />
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-prompt-form]");
  const field = form?.querySelector<HTMLTextAreaElement>("textarea");

  if (form && field) {
    // The field grows with what is typed into it, so a long description is
    // not read through a two-line slot. The ceiling is the CSS max-height,
    // which caps the inline height too, so the number lives there alone. An
    // empty box drops its inline height and goes back to its CSS one.
    const fit = () => {
      if (!field.value) {
        field.style.height = "";
        return;
      }
      field.style.height = "auto";
      field.style.height = `${field.scrollHeight}px`;
    };
    field.addEventListener("input", fit);
    // A width change rewraps the text, so the box is fitted again.
    addEventListener("resize", fit);

    // The placeholder types itself: a fixed opening, then one prewritten board
    // after another, typed out, held and deleted. The opening and the boards
    // are data attributes on the field (see the frontmatter). It is the
    // placeholder attribute being rewritten, not an overlay, so it disappears
    // the moment the reader types and never has to be kept out of the way of
    // real text. The static sentence in the markup is what a reader with
    // reduced motion (or no script) sees, and what it returns to if reduced
    // motion is turned on mid-visit. Turned off again, the typing restarts.
    // The moment the box takes focus the current example is put up whole and
    // stands still, so nothing moves under a reader who is about to type and
    // a screen reader never reads half a sentence as the hint.
    //
    // The loop stops rather than idles while the hero is off screen or the
    // box has focus. The observer and the blur start it again.
    const STILL = field.placeholder;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const LEAD = field.dataset.lead ?? "";
    const IDEAS: string[] = JSON.parse(field.dataset.ideas ?? "[]");
    const TYPE = 42; // ms per character typed
    const ERASE = 18; // per character deleted
    const HOLD = 1900; // a finished line stays this long
    const GAP = 380; // the pause on the bare opening before the next line

    let idea = 0;
    let shown = 0;
    let erasing = false;
    let onScreen = true;
    // Set while a tick is pending, so undefined means the loop is stopped.
    let timer: ReturnType<typeof setTimeout> | undefined;

    const later = (ms: number) => {
      clearTimeout(timer);
      timer = setTimeout(tick, ms);
    };
    const halt = () => {
      clearTimeout(timer);
      timer = undefined;
    };
    const start = (ms: number) => {
      if (timer === undefined && IDEAS.length && !reduce.matches) later(ms);
    };
    // The current example, whole. Erased from there once focus leaves.
    const whole = () => {
      shown = IDEAS[idea].length;
      erasing = true;
      field.placeholder = LEAD + IDEAS[idea];
    };

    const tick = () => {
      timer = undefined;
      if (reduce.matches) {
        field.placeholder = STILL;
        return;
      }
      if (!onScreen) return;
      if (document.activeElement === field) {
        whole();
        return;
      }
      // Nothing to animate while there is real text in the field or the tab
      // is in the background; look again shortly.
      if (field.value || document.hidden) {
        later(400);
        return;
      }

      const text = IDEAS[idea];
      shown += erasing ? -1 : 1;
      field.placeholder = LEAD + text.slice(0, shown);

      let wait = erasing ? ERASE : TYPE;
      if (!erasing && shown === text.length) {
        erasing = true;
        wait = HOLD;
      } else if (erasing && shown === 0) {
        erasing = false;
        idea = (idea + 1) % IDEAS.length;
        wait = GAP;
      }
      later(wait);
    };

    if (IDEAS.length) {
      if (!reduce.matches) field.placeholder = LEAD;
      start(700);

      const hero = form.closest(".hero");
      if (hero) {
        new IntersectionObserver(([e]) => {
          onScreen = e.isIntersecting;
          if (onScreen) start(GAP);
        }).observe(hero);
      }

      field.addEventListener("focus", () => {
        if (reduce.matches) return;
        halt();
        whole();
      });
      field.addEventListener("blur", () => start(GAP));

      reduce.addEventListener("change", () => {
        halt();
        if (reduce.matches) {
          field.placeholder = STILL;
          return;
        }
        shown = 0;
        erasing = false;
        field.placeholder = LEAD;
        start(GAP);
      });
    }

    // ── The handoff to the app's guest chat. The box is an ordinary text box:
    // the visitor clicks in and types. Start building or Enter goes to
    // app.copperhead.sh/new#prompt=<text>, and an empty box keeps them here
    // with the cursor in it. A fragment reaches no server, log or referrer. The
    // app reads it once (lib/guest/prompt.ts in copperhead-cloud) and takes at
    // most 8,000 characters, which is this box's limit too. Only this script
    // puts the text there. The form's action is the same address and the
    // textarea has no name, so with no script the button still opens the app
    // but carries nothing; the <noscript> line under the box tells the reader.
    // A named field would carry the text without script, in a query string
    // that every server and log on the way can read.
    const target = () => {
      const text = field.value.trim();
      if (!text) return form.action;
      // A lone surrogate (half an emoji, cut or pasted) makes
      // encodeURIComponent throw. toWellFormed swaps it for U+FFFD where the
      // browser has it.
      return `${form.action}#prompt=${encodeURIComponent(text.toWellFormed?.() ?? text)}`;
    };

    // The way out: the app starts loading at once, and while it does the page
    // fades to its background, the colour the app's page opens on, so the
    // switch is a fade rather than a flash. Nothing waits on the fade. If the
    // app takes a moment, a thin copper bar runs along the top so the empty
    // screen reads as loading, not as stuck. The veil takes the clicks, and
    // the page under it is made inert so Tab cannot reach it either. It stays
    // up until the app's page replaces this one. Esc hands the page back at
    // once. The Stop button tells the page nothing, so after Stop (or if the
    // app never answers) it is handed back after ten seconds and the box
    // works again.
    let leaving = false;
    let veil: HTMLElement | null = null;
    let giveUp: ReturnType<typeof setTimeout> | undefined;
    // Where focus was. Going inert takes it away, and stay() puts it back.
    let back: HTMLElement | null = null;
    const under = () => document.querySelectorAll<HTMLElement>("body > :is(header, main, footer)");

    const stay = () => {
      clearTimeout(giveUp);
      veil?.remove();
      veil = null;
      leaving = false;
      for (const el of under()) el.inert = false;
      if (back && document.activeElement === document.body) back.focus({ preventScroll: true });
      back = null;
    };

    const go = () => {
      if (leaving) return;
      // Before anything changes, so a throw leaves the page as it was.
      const href = target();
      leaving = true;

      if (!reduce.matches) {
        veil = document.createElement("div");
        veil.className = "handoff";
        veil.setAttribute("aria-hidden", "true");
        veil.innerHTML = '<div class="handoff-loading"></div>';
        document.body.append(veil);
        back = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        for (const el of under()) el.inert = true;
      }

      giveUp = setTimeout(stay, 10_000);
      location.assign(href);
    };

    // Build: there has to be something to build first.
    const build = () => {
      if (field.value.trim()) go();
      else field.focus();
    };

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      build();
    });

    // Enter builds and Shift+Enter breaks the line, as in every chat box. An
    // Enter that confirms an input method's candidate (Japanese, Chinese) is
    // the input method's, not ours: Safari ends the composition before that
    // keydown, so isComposing is already false there and only keyCode 229
    // says so.
    field.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" || e.shiftKey || e.isComposing || e.keyCode === 229) return;
      e.preventDefault();
      build();
    });

    // Esc can stop the navigation, which would leave this page behind the
    // veil. Hand it back now rather than in ten seconds.
    addEventListener("keydown", (e) => {
      if (e.key === "Escape" && leaving) stay();
    });

    // Back from the app restores this page from the back/forward cache with
    // the veil still up. Take it down.
    addEventListener("pageshow", (e) => {
      if (e.persisted) stay();
    });
  }
</script>

<style>
  /* The section is the fold: one viewport tall wherever there is room, and a
     floor rather than a fixed height, so a window too short for the stack
     grows and scrolls instead of shearing the backer strip off the bottom.
     A column: the copy takes the slack and centres in it, the strip keeps its
     own height. */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    /* "Clear the bar, then leave a gap": the bar is fixed and the hero cannot
       see it, so a padding stated as a bare svh fraction shrinks toward the
       bar on a short viewport and the chip ends up resting on its rule. */
    padding-block: calc(var(--nav-h) + clamp(24px, 4.6svh, 58px))
      clamp(24px, 6svh, 72px);
    overflow: hidden;
  }

  .hero .wrap {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    /* `safe`, so a stack taller than the fold falls back to top-anchored and
       the headline stays on screen instead of being pushed off the top. */
    justify-content: safe center;
  }

  .copy {
    flex: none;
    min-width: 0;
    text-align: center;
  }

  .strip {
    position: relative;
    flex: none;
    margin-top: clamp(16px, 3.4svh, 2.5rem);
  }

  /* No glow. Two were tried and both came out: one rising from the bottom
     edge, which put a coloured cloud under the backer logos, and one as a
     halo behind the panel, which read as a smudge round a box that is
     otherwise all straight edges. The panel is set off by its frame and the
     copper ring it takes on focus, and the fold is flat.

     The width is in rem, not px, so a reader with a larger default text size
     gets a wider panel to match and the line counts below still hold. */
  .stage {
    width: min(100%, 47.5rem);
    margin: clamp(22px, 4.4svh, 40px) auto 0;
  }

  /* The dot field, rule for rule the one the live site runs: dense along all
     four edges, the bottom included, thinning to almost nothing through the
     middle. A diamond lattice: two dot grids on a 16x11 pitch, the second offset by
     half of each, so every dot's nearest neighbours are on its diagonals and
     the cell reads as a rhombus rather than as offset rows. The soft ramp on
     each dot is antialiasing by hand: a hard-edged radial gradient gets none,
     and at this diameter resolves as a square. */
  .grid-dots {
    --pitch: 16px;
    --rise: 11px;
    /* the ramp's outer edge; the gradient is sized to it so the dot is not
       clipped by its own tile */
    --edge: 1.15px;

    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        circle at var(--edge) var(--edge),
        color-mix(in srgb, var(--copper) 38%, transparent) 0 0.65px,
        transparent var(--edge)
      ),
      radial-gradient(
        circle at var(--edge) var(--edge),
        color-mix(in srgb, var(--copper) 38%, transparent) 0 0.65px,
        transparent var(--edge)
      );
    background-size:
      var(--pitch) var(--rise),
      var(--pitch) var(--rise);
    background-position:
      0 0,
      calc(var(--pitch) / 2) calc(var(--rise) / 2);
    /* The field is a frame: dense along all four edges, thinning inward to
       almost nothing through the middle.

       Two gradients, one per axis, and they are unioned rather than
       intersected — that is the whole thing. `intersect` multiplies, so a pixel
       had to be near the left/right edge *and* low on the page to survive, which
       is why every earlier version was a pair of side bands or a dome rather
       than a border. `add` takes the stronger of the two, so a pixel is dense
       if it is near any edge, the corners get both, and the centre keeps only
       what the two flat middles sum to.

       Those middles are 3% each, so the centre sits at 6% — enough that the
       copy column is not a bare white hole in the field, low enough to read
       every line of type over it.

       The four edges are not equal. Left, right and bottom run to full, but the
       top peaks at 14% and is back to the flat middle by a fifth of the way
       down: it is the edge nearest the navbar's rule and the one the headline
       sits closest to. At full strength it read as a second rule under the
       first, and even at 30% over a band 350px deep it put a wash across the
       whole headline. The corners keep their weight regardless — the
       horizontal gradient is already at full there, and under `add` the
       stronger of the two wins — so the frame still closes at all four corners
       rather than fraying at the top. The transparent sliver above it keeps the
       field off the navbar rule entirely. */
    -webkit-mask-image:
      linear-gradient(
        90deg,
        #000 0%,
        rgba(0, 0, 0, 0.03) 30%,
        rgba(0, 0, 0, 0.03) 70%,
        #000 100%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        rgba(0, 0, 0, 0.14) 4%,
        rgba(0, 0, 0, 0.03) 20%,
        rgba(0, 0, 0, 0.03) 74%,
        #000 100%
      );
    -webkit-mask-composite: source-over;
    mask-image:
      linear-gradient(
        90deg,
        #000 0%,
        rgba(0, 0, 0, 0.03) 30%,
        rgba(0, 0, 0, 0.03) 70%,
        #000 100%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        rgba(0, 0, 0, 0.14) 4%,
        rgba(0, 0, 0, 0.03) 20%,
        rgba(0, 0, 0, 0.03) 74%,
        #000 100%
      );
    mask-composite: add;
  }

  /* ── Announcement chip: 33px tall on a panel fill, a 1px accent-tinted
     frame and two segments. No rule between them: the tag's tinted fill ends
     and that edge reads as the divider. ── */
  .chip {
    display: inline-flex;
    align-items: stretch;
    max-width: 100%;
    height: 33px;
    border: 1px solid color-mix(in srgb, var(--copper) 25%, transparent);
    background: var(--panel);
    font-size: 0.78125rem; /* 12.5px */
    font-weight: 500;
    letter-spacing: -0.005em;
    text-decoration: none;
    text-align: left;
    transition: border-color 0.16s ease;
  }

  .chip:hover {
    border-color: color-mix(in srgb, var(--copper) 45%, transparent);
  }

  .chip-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: color-mix(in srgb, var(--copper) 8%, transparent);
    color: var(--copper);
  }

  /* A 12px outlined square with an 8px filled one inside it, from one
     element: the border and padding inset the content box, and
     background-clip keeps the fill off the padding. */
  .chip-dot {
    width: 12px;
    height: 12px;
    flex: none;
    padding: 1px;
    border: 1px solid color-mix(in srgb, var(--copper) 40%, transparent);
    background: var(--copper);
    background-clip: content-box;
  }

  .chip-text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    color: var(--text);
    /* allowed to shrink below its content, or the title pushes the chip past
       the column instead of truncating */
    min-width: 0;
    overflow: hidden;
  }

  /* The chip is one line by construction and the newest title is whatever it
     is, so it is the title that truncates. */
  .chip-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chip-arrow {
    flex: none;
    opacity: 0.6;
  }

  /* ── Headline. Space Grotesk 500 on 1.04 leading with -0.058em of tracking,
     the display metrics the two-column hero ran. The `min()` adds a height
     term to the usual width clamp, because the headline is the one item on
     the fold that can eat the panel's room on a short window. One line at
     every desktop width: "AI for PCB design." is 18 characters. ── */
  h1 {
    font-size: clamp(2.5rem, min(6.4vw, 10svh), 5.5rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.058em;
    margin: clamp(18px, 3.4svh, 30px) auto 0;
    text-wrap: balance;
  }

  /* the headline ends on a coloured full stop */
  .stop {
    color: var(--copper);
  }

  .sub {
    color: var(--text-dim);
    font-size: 1.1875rem; /* 19px */
    line-height: 1.55;
    letter-spacing: -0.012em;
    max-width: 39em;
    margin: clamp(12px, 2.4svh, 20px) auto 0;
    text-wrap: balance;
  }

  /* ── The panel, to the cloud app's prompt: a 28px pill on the panel fill
     with a stronger hairline, 8px of padding and a 40px copper button beside
     the field. The one rounded box on a square site, on purpose: it is the
     app's control, shown as the app shows it.

     The field and the button share one row, the button centred down the
     box's right side. On a wide screen the field is one line tall, so the
     text and the button sit in the middle together. Where the moving
     placeholder needs more lines (see the media queries), the field starts
     that tall rather than cutting it off, and the button stays in the middle
     of it. ── */
  .panel {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    background: var(--panel);
    border: 1px solid var(--line-hi);
    border-radius: 28px;
    box-shadow: var(--lift);
    text-align: left;
    transition: border-color 0.16s ease;
  }

  /* The textarea draws no outline of its own; the panel draws it instead,
     the site's 2px copper ring (global.css) round the pill. A text field
     matches :focus-visible however it was focused, so the ring shows for a
     click as well as for Tab. Any focus inside the panel also lightens its
     border. The transparent outline is for forced colours (Windows High
     Contrast) in a browser without :has(), which flattens the border change
