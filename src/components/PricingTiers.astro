---
import { links } from "../config";

// Four tiers on one row, in the cal.com pricing shape: a large headline, a
// one-line lede, then a card each for CLI / Cloud / Team /
// Enterprise. Cloud is the emphasised card (cal.com highlights one column in a
// dark fill); here it takes a copper frame instead, the site's one accent.
// Copy is anchored to the pricing model doc; nothing paid is ever required to
// use Copperhead fully. The free CLI does every core operation.
//
// Each card is a summary: a one-line blurb and four features short enough to
// hold one line each. The longer account of each plan is PricingDetails.astro
// on /pricing/. A feature that needs a clause to explain it belongs there.
interface Tier {
  name: string;
  price: string;
  unit?: string;
  addon?: string;
  blurb: string;
  cta: { label: string; href: string };
  note?: string;
  featured?: boolean;
  headline: string;
  features: string[];
}

const tiers: Tier[] = [
  {
    name: "CLI",
    price: "Free",
    note: "Apache-2.0, forever",
    blurb: "Design on your own machine.",
    cta: { label: "Get started", href: "/#quickstart" },
    headline: "Includes:",
    features: [
      "The full agent, run locally",
      "Bring your own model key",
      "Your KiCad files, your repo",
      "Never metered",
    ],
  },
  {
    name: "Cloud",
    price: "$49",
    unit: "per user / month",
    blurb: "Hosted runs on private repos.",
    cta: { label: "Let's talk", href: links.getStarted },
    note: "Free for open hardware repos",
    featured: true,
    headline: "Everything in CLI, plus:",
    features: [
      "Hosted runs, no setup",
      "Private repositories",
      "Web viewer, live renders",
      "One-click exports",
    ],
  },
  {
    name: "Team",
    price: "$49",
    unit: "per user / month",
    addon: "+ $199 / mo platform",
    blurb: "Governance and CI for a team.",
    cta: { label: "Let's talk", href: links.getStarted },
    headline: "Everything in Cloud, plus:",
    features: [
      "CI bot on pull requests",
      "Shared constraint libraries",
      "SSO / SAML and roles",
      "Pooled credits",
    ],
  },
  {
    name: "Enterprise",
    price: "Custom",
    unit: "annual",
    blurb: "Self-hosted, flat annual price.",
    // The booking page, like the other paid tiers. It was a mailto: link, which
    // does nothing on a machine with no mail app set up.
    cta: { label: "Talk to sales", href: links.getStarted },
    headline: "Everything in Team, plus:",
    features: [
      "Self-hosted or VPC",
      "Altium support",
      "SLA and dedicated support",
      "Compliance audit trail",
    ],
  },
];

// The pricing page anchors its own top here; the homepage cannot, because the
// hero already owns that id and two of them on one document is invalid.
interface Props {
  id?: string;
  /** On /pricing/ this is the page's masthead, which is the page's name alone;
      on the homepage it is a section and keeps its headline and lede. */
  page?: boolean;
}
const { id = 'top', page = false } = Astro.props;
---

<section id={id} class="tiers">
  <div class="wrap">
    <div class="top">
      <div class="head">
        {
          page ? (
            <h1 class="section-title">Pricing</h1>
          ) : (
            <>
              <h2 class="section-title">What the paid plans add.</h2>
              <p class="section-intro">
                Copperhead is open core. The CLI is free and does the design
                work on its own. The paid plans add hosting, team features and
                the audit trail a compliance review asks for.
              </p>
            </>
          )
        }
      </div>

      <div class="actions">
        <a class="btn btn-primary" href={links.getStarted}>Talk to sales</a>
      </div>
    </div>

    <ul class="grid">
      {
        tiers.map((t) => (
          <li class:list={["card", { featured: t.featured }]}>
            {t.featured && <span class="badge">Most popular</span>}
            {/* One level under the section's heading: h2 under /pricing/'s
                h1, h3 under the home page section's h2. */}
            {page ? <h2 class="name">{t.name}</h2> : <h3 class="name">{t.name}</h3>}

            <div class="price">
              <span class="amount">{t.price}</span>
              {t.unit && <span class="unit">{t.unit}</span>}
            </div>
            <div class="meta">
              {t.addon && <p class="addon">{t.addon}</p>}
              {t.note && <p class="tier-note">{t.note}</p>}
            </div>

            <p class="blurb">{t.blurb}</p>

            <a
              class:list={["btn", t.featured ? "btn-primary" : "btn-secondary"]}
              href={t.cta.href}
            >
              {t.cta.label}
            </a>

            <p class="feat-head">{t.headline}</p>
            <ul class="feats">
              {t.features.map((f) => (
                <li>
                  <svg
                    class="check"
                    viewBox="0 0 16 16"
                    width="15"
                    height="15"
                    aria-hidden="true"
                  >
                    <path
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 8.5l3.2 3.2L13 4.5"
                    />
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tiers {
    /* Clear the 60px fixed navbar, then a comfortable gap above the headline. */
    padding-block-start: 119px;
  }

  .tiers .wrap {
    padding-top: 0;
  }

  /* On desktop the CTA sits at the right, level with the last line of the
     intro, so it doesn't spend a row of its own above the cards. */
  .top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
  }

  .section-intro {
    max-width: 58ch;
  }

  .actions {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Four separate bordered cards with a gap, cal.com style, not the shared
     1px-gutter frame used elsewhere, because one card needs its own accent. */
  .grid {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  /* Row subgrid, so name, price, meta, blurb, CTA and feature list each sit on
     a track shared by all four cards. That is what actually aligns the CTAs:
     the previous approach padded .blurb to a min-height and hoped, which held
     until a tier carried a different combination of the optional addon and note
     rows — Enterprise did, and its "Talk to sales" sat proud of the three
     "Let's talk" buttons beside it. Every card emits the same seven in-flow
     children — name, price, meta, blurb, CTA, feature heading, feature list —
     with .meta present but empty where a tier carries no addon or note. The
     badge is absolutely positioned, so it is not a grid item and does not
     count toward the span. */
  .card {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 7;
    background: var(--panel);
    border: 2px solid var(--line);
    padding: 24px 24px 26px;
  }

  /* The wash is mixed into the page rather than into a fixed white, so on the
     dark theme it comes out a warm near-black lift rather than a pale band. */
  .card.featured {
    border-color: color-mix(in srgb, var(--copper) 45%, transparent);
    background: color-mix(in srgb, var(--copper) 6%, var(--bg));
    position: relative;
  }

  .badge {
    position: absolute;
    top: -11px;
    left: 24px;
    padding: 3px 10px;
    background: var(--copper);
    color: var(--on-copper);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* line-height and letter-spacing pinned, since an h3 would otherwise take
     global.css's lighter subhead settings and the cards would differ by page. */
  .name {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 1.1rem;
  }

  .amount {
    font-family: var(--display);
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .unit {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .addon {
    margin: 0.55rem 0 0;
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .tier-note {
    margin: 0.55rem 0 0;
    color: var(--copper);
    font-size: 0.82rem;
  }

  .blurb {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0.85rem 0 1.25rem;
  }

  .card .btn {
    width: 100%;
  }

  .feat-head {
    margin: 1.4rem 0 0.85rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
  }

  .feats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .feats li {
    display: flex;
    gap: 10px;
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .check {
    flex: none;
    margin-top: 2px;
    color: var(--copper);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 860px) {
    .top {
      display: block;
    }

    .actions {
      margin-top: 2rem;
    }
  }

  @media (max-width: 560px) {
    .tiers {
      /* Clear the 60px fixed navbar, then a comfortable gap above the headline. */
      padding-block-start: 103px;
    }

    .actions {
      gap: 10px;
      margin-top: 1.5rem;
    }

    .actions .btn {
      font-size: 0.85rem;
      padding: 0.6rem 1.1rem;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 2rem;
    }

    .card {
      padding: 22px 20px 24px;
    }

    .badge {
      left: 20px;
    }

    .price {
      margin-top: 0.9rem;
    }

    .amount {
      font-size: 2.15rem;
    }

    .blurb {
      min-height: 0;
      margin: 0.85rem 0 1.2rem;
      font-size: 0.92rem;
    }

    .feat-head {
      margin: 1.35rem 0 0.85rem;
    }

    .feats {
      gap: 0.6rem;
    }

    .feats li {
      font-size: 0.88rem;
    }
  }
</style>
