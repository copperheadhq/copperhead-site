---
// The backer strip: a slow, seamless logo marquee in the shape every startup
// site runs under its fold. It closes the hero, so it caps itself at --maxw
// and fades out just inside the frame's vertical rules.
//
// Marks are the official brand paths — simple-icons (CC0) except Sarvam's,
// which simple-icons has none of and which comes from Sarvam's own SVG — drawn in
// currentColor so the whole row is one ink and reads as a set instead of nine
// competing brand palettes — the standard treatment for a partner strip, and
// the only one that survives this site's light and dark themes. Each carries
// its own optical `size`: the AWS mark is a short wide wordmark and the rest
// are square symbols, so matching their box heights would make AWS look half
// the size of the others. Match the ink, not the box.
//
// AWS Activate's lockup is the wordmark plus the programme name, which is why
// its label is "Activate" and not "AWS Activate" — the mark already says AWS.
//
// The strip carries no outer padding of its own. It is a band, not a section,
// and the page it sits in knows better than it does how much air belongs above
// and below — the hero has a fold to fit it into.
interface Props {
  /** Small mono label above the row. Written sentence case, set uppercase. */
  caption?: string;
}

const { caption } = Astro.props;

interface Backer {
  /** Set beside the mark. The mark supplies the brand where it already reads. */
  label: string;
  /** Spoken name, for the strip's single aria-label. */
  name: string;
  /** simple-icons path, drawn for `viewBox` below. */
  path: string;
  /** Rendered height in px, chosen by ink rather than by box. */
  size: number;
  /**
   * The mark's own coordinate space. simple-icons normalises every mark to
   * 24x24, which is the default, so only a mark taken from a brand's own SVG
   * needs this — see Sarvam below.
   */
  viewBox?: string;
}

// Both Google entries take the same G. simple-icons has no Google Workspace
// mark, and Workspace's own is a four-colour glyph that does not survive being
// flattened to one ink — so the brand mark carries the brand and the label
// carries which programme it is. The order below puts them four apart, which in
// a loop of nine is as far apart as they can get: the strip wraps, so the
// distance that matters is the shorter way round. They sat three apart until two
// identical G's with only AWS and Clerk between them still read as a repeat
// rather than as two programmes.
const GOOGLE_G =
  'M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z';

// Sarvam's interlaced ring, from their own brand SVG rather than simple-icons,
// which carries no Sarvam mark. It is the one mark here in its own coordinate
// space (86x85), hence the `viewBox` field — rewriting its geometry into a
// 24x24 box by hand would only risk distorting someone's logo to save an
// attribute.
//
// It is also by far the longest path in the set, at roughly four times the AWS
// wordmark, and the template repeats every mark fourteen times. Measured on the
// built home page, it costs 24kB raw and 4.6kB brotli. The gap between those two
// numbers is the fourteen copies being byte-identical: compression collapses the
// repeat almost entirely, so what is left is the price of the path once, and
// hoisting the marks into a <symbol> to dedupe them by hand would buy back
// almost nothing on the wire.
//
// Rounding its coordinates down to shrink it is a trap worth naming, because the
// raw figure invites it. The mark is full of sub-0.05 deltas that round to zero
// at one decimal; a zeroed delta merges into its neighbour, the coordinates
// after it shift by one and the path shears apart.
