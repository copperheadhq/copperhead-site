  },
  {
    label: 'Clerk',
    name: 'Clerk',
    size: 21,
    path: 'm21.47 20.829-2.881-2.881a.572.572 0 0 0-.7-.084 6.854 6.854 0 0 1-7.081 0 .576.576 0 0 0-.7.084l-2.881 2.881a.576.576 0 0 0-.103.69.57.57 0 0 0 .166.186 12 12 0 0 0 14.113 0 .58.58 0 0 0 .239-.423.576.576 0 0 0-.172-.453Zm.002-17.668-2.88 2.88a.569.569 0 0 1-.701.084A6.857 6.857 0 0 0 8.724 8.08a6.862 6.862 0 0 0-1.222 3.692 6.86 6.86 0 0 0 .978 3.764.573.573 0 0 1-.083.699l-2.881 2.88a.567.567 0 0 1-.864-.063A11.993 11.993 0 0 1 6.771 2.7a11.99 11.99 0 0 1 14.637-.405.566.566 0 0 1 .232.418.57.57 0 0 1-.168.448Zm-7.118 12.261a3.427 3.427 0 1 0 0-6.854 3.427 3.427 0 0 0 0 6.854Z',
  },
  {
    label: 'Google Workspace',
    name: 'Google Workspace',
    size: 21,
    path: GOOGLE_G,
  },
  {
    label: 'Supabase',
    name: 'Supabase',
    size: 21,
    path: 'M11.9 1.036c-.015-.986-1.26-1.41-1.874-.637L.764 12.05C-.33 13.427.65 15.455 2.409 15.455h9.579l.113 7.51c.014.985 1.259 1.408 1.873.636l9.262-11.653c1.093-1.375.113-3.403-1.645-3.403h-9.642z',
  },
  // Last in the order, which keeps it clear of both G's. Its mark is the face
  // and the face alone says nothing, so unlike Activate the label carries the
  // whole name. Flattened to one ink it loses the yellow it is known by, which
  // is the same trade every other mark here makes.
  {
    label: 'Hugging Face',
    name: 'Hugging Face',
    size: 22,
    path: 'M12.025 1.13c-5.77 0-10.449 4.647-10.449 10.378 0 1.112.178 2.181.503 3.185.064-.222.203-.444.416-.577a.96.96 0 0 1 .524-.15c.293 0 .584.124.84.284.278.173.48.408.71.694.226.282.458.611.684.951v-.014c.017-.324.106-.622.264-.874s.403-.487.762-.543c.3-.047.596.06.787.203s.31.313.4.467c.15.257.212.468.233.542.01.026.653 1.552 1.657 2.54.616.605 1.01 1.223 1.082 1.912.055.537-.096 1.059-.38 1.572.637.121 1.294.187 1.967.187.657 0 1.298-.063 1.921-.178-.287-.517-.44-1.041-.384-1.581.07-.69.465-1.307 1.081-1.913 1.004-.987 1.647-2.513 1.657-2.539.021-.074.083-.285.233-.542.09-.154.208-.323.4-.467a1.08 1.08 0 0 1 .787-.203c.359.056.604.29.762.543s.247.55.265.874v.015c.225-.34.457-.67.683-.952.23-.286.432-.52.71-.694.257-.16.547-.284.84-.285a.97.97 0 0 1 .524.151c.228.143.373.388.43.625l.006.04a10.3 10.3 0 0 0 .534-3.273c0-5.731-4.678-10.378-10.449-10.378M8.327 6.583a1.5 1.5 0 0 1 .713.174 1.487 1.487 0 0 1 .617 2.013c-.183.343-.762-.214-1.102-.094-.38.134-.532.914-.917.71a1.487 1.487 0 0 1 .69-2.803m7.486 0a1.487 1.487 0 0 1 .689 2.803c-.385.204-.536-.576-.916-.71-.34-.12-.92.437-1.103.094a1.487 1.487 0 0 1 .617-2.013 1.5 1.5 0 0 1 .713-.174m-10.68 1.55a.96.96 0 1 1 0 1.921.96.96 0 0 1 0-1.92m13.838 0a.96.96 0 1 1 0 1.92.96.96 0 0 1 0-1.92M8.489 11.458c.588.01 1.965 1.157 3.572 1.164 1.607-.007 2.984-1.155 3.572-1.164.196-.003.305.12.305.454 0 .886-.424 2.328-1.563 3.202-.22-.756-1.396-1.366-1.63-1.32q-.011.001-.02.006l-.044.026-.01.008-.03.024q-.018.017-.035.036l-.032.04a1 1 0 0 0-.058.09l-.014.025q-.049.088-.11.19a1 1 0 0 1-.083.116 1.2 1.2 0 0 1-.173.18q-.035.029-.075.058a1.3 1.3 0 0 1-.251-.243 1 1 0 0 1-.076-.107c-.124-.193-.177-.363-.337-.444-.034-.016-.104-.008-.2.022q-.094.03-.216.087-.06.028-.125.063l-.13.074q-.067.04-.136.086a3 3 0 0 0-.135.096 3 3 0 0 0-.26.219 2 2 0 0 0-.12.121 2 2 0 0 0-.106.128l-.002.002a2 2 0 0 0-.09.132l-.001.001a1.2 1.2 0 0 0-.105.212q-.013.036-.024.073c-1.139-.875-1.563-2.317-1.563-3.203 0-.334.109-.457.305-.454m.836 10.354c.824-1.19.766-2.082-.365-3.194-1.13-1.112-1.789-2.738-1.789-2.738s-.246-.945-.806-.858-.97 1.499.202 2.362c1.173.864-.233 1.45-.685.64-.45-.812-1.683-2.896-2.322-3.295s-1.089-.175-.938.647 2.822 2.813 2.562 3.244-1.176-.506-1.176-.506-2.866-2.567-3.49-1.898.473 1.23 2.037 2.16c1.564.932 1.686 1.178 1.464 1.53s-3.675-2.511-4-1.297c-.323 1.214 3.524 1.567 3.287 2.405-.238.839-2.71-1.587-3.216-.642-.506.946 3.49 2.056 3.522 2.064 1.29.33 4.568 1.028 5.713-.624m5.349 0c-.824-1.19-.766-2.082.365-3.194 1.13-1.112 1.789-2.738 1.789-2.738s.246-.945.806-.858.97 1.499-.202 2.362c-1.173.864.233 1.45.685.64.451-.812 1.683-2.896 2.322-3.295s1.089-.175.938.647-2.822 2.813-2.562 3.244 1.176-.506 1.176-.506 2.866-2.567 3.49-1.898-.473 1.23-2.037 2.16c-1.564.932-1.686 1.178-1.464 1.53s3.675-2.511 4-1.297c.323 1.214-3.524 1.567-3.287 2.405.238.839 2.71-1.587 3.216-.642.506.946-3.49 2.056-3.522 2.064-1.29.33-4.568 1.028-5.713-.624',
  },
];

// A group has to be wider than the widest viewport or the rail runs out of
// logos mid-screen and the strip shows a hole. One pass of the list no longer
// is: at seven lockups it clears the 1328px frame on its own, where the five
// this note was written for came to roughly 1150px and did not. The doubling
// stays anyway — it costs one repeated pass and it is what keeps the seam
// invisible, and the list is short enough to fall back under the frame again
// if a backer is ever dropped.
// The second pass is marked `dup` rather than counted, so the reduced-motion
// rule that drops it back to a single set reads the list's own length instead
// of a hardcoded count that each new backer would silently break.
const group = [
  ...backers.map((b) => ({ ...b, dup: false })),
  ...backers.map((b) => ({ ...b, dup: true })),
];

// One label for the whole strip. The rail is role="img", so assistive tech
// reads this sentence once instead of walking twenty duplicated list items.
const spoken = `Backed by ${backers.map((b) => b.name).join(', ')}`;
---

<section class="backers" aria-label="Backers">
  {caption && <p class="caption">{caption}</p>}
  <div class="marquee" role="img" aria-label={spoken}>
    <div class="rail">
      {
        /* Two identical groups. The animation travels exactly one group width
           (-50% of the rail) and restarts, so the seam lands where the second
           group's first logo is already standing in the first's place. Each
           group carries the trailing gap itself — putting that gap on .rail
           instead would make one group width and -50% differ by half a gap,
           which is exactly the visible stutter this shape avoids. */
        [0, 1].map(() => (
          <div class="group">
            {group.map((b) => (
              <div class:list={['lockup', b.dup && 'dup']}>
                <svg
                  class="mark"
                  viewBox="0 0 24 24"
                  height={b.size}
                  width={b.size}
                  aria-hidden="true"
                  focusable="false"
                >
                  <path fill="currentColor" d={b.path} />
                </svg>
                <span class="name">{b.label}</span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* No padding: the strip is a band and the page owns the air around it. See
     the note in the frontmatter. */
  .backers {
    padding-block: 0;
  }

  /* Reference-designator type, the same voice SectionRule's label speaks in —
     this row used to sit under one of those and lost it on the move into the
     hero, so the label comes with it rather than leaving six logos to explain
     themselves. No chevron: that glyph is the section rule's own mark, and
     borrowing it here would promise a divider that is not there. */
  .caption {
    margin: 0 0 1.25rem;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .marquee {
    /* No .wrap: the rail runs the full width of the framed column so it fades
       out against the frame's vertical rules instead of stopping short of
       them. */
    max-width: var(--maxw);
    margin-inline: auto;
    overflow: hidden;
    /* Feathered ends, so logos arrive and leave rather than being cut off at a
       hard edge. Both properties, not just the standard one: WebKit still needs
       the prefix for mask-image on this. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }

  .rail {
    display: flex;
    width: max-content;
    /* Slow enough to read as a background texture rather than as something
       demanding to be watched: about 30px a second, or a logo width every four
       seconds. The strip sits inside the fold now, next to a terminal that is
       already animating, so it has to drift rather than travel — anything
       quicker and the two compete for the same glance. */
    animation: roll 80s linear infinite;
  }

  /* WCAG 2.2.2 wants a way to stop moving content. Reduced motion below is the
     real answer; this is the one for a reader who simply wants to look at a
     logo without chasing it. */
  .marquee:hover .rail,
  .marquee:focus-within .rail {
    animation-play-state: paused;
  }

  @keyframes roll {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .group {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding-right: 4rem; /* the seam's gap; see the note in the template */
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .mark {
    flex: none;
    display: block;
  }

  .name {
    font-size: 1.0625rem; /* 17px */
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  @media (max-width: 720px) {
    .caption {
      margin-bottom: 0.9rem;
      letter-spacing: 0.1em;
    }

    .group {
      gap: 2.5rem;
      padding-right: 2.5rem;
    }

    .name {
      font-size: 0.9375rem; /* 15px */
    }

    /* A phone is a fifth of the width, so the same pixel speed reads as a
       sprint. Slow it further to keep the strip calm. */
    .rail {
      animation-duration: 115s;
    }
  }

  /* Not merely a slower marquee: no marquee. The global reduce block clamps
     animation-duration, which would leave this scrolling in one frame, so the
     strip becomes what it should have been all along for these readers — a
     static, centred, wrapping row. One group is enough once nothing moves, and
     the second is the duplicate, so it goes. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
      padding-inline: 32px;
    }

    .rail {
      width: auto;
      animation: none;
      justify-content: center;
    }

    .group:last-child {
      display: none;
    }

    .group {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem 3rem;
      padding-right: 0;
    }

    /* The list is doubled to keep the moving rail full; standing still, that
       doubling is just the same logos printed twice. */
    .lockup.dup {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) and (max-width: 720px) {
    .marquee {
      padding-inline: 22px;
    }
  }
</style>
