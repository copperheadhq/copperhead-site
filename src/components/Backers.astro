// A group has to be at least as wide as the rail's own box or the loop runs out
// of logos mid-screen and the strip shows a hole. The .marquee is capped at
// --maxw, so that box is 1328px and never more, whatever the viewport does.
//
// The list used to be doubled here to reach it, back when five lockups came to
// roughly 1150px and fell short. By eight they measured 1631px and the doubling
// had become 16 redundant lockups — with the two groups the template renders,
// 32 in the built page — so it came out. Nine now measure 1885px, so a single
// pass clears 1328 by 557px on its own.
//
// The margin is the thing to watch: drop below about five backers, or shorten
// the labels much, and one pass falls under 1328 again and the seam opens. It
// is measurable — one .group's width against the .marquee's — so measure it
// rather than assuming, and put the second pass back here if it goes negative.
const group = backers;

// One label for the whole strip. The rail is role="img", so assistive tech
// reads this sentence once instead of walking the eighteen repeated lockups the
// seam needs.
const spoken = `Backed by ${backers.map((b) => b.name).join(', ')}`;
---

<section class="backers" aria-label="Backers">
  {caption && <p class="caption">{caption}</p>}
  {/* data-bleed-ok: the rail inside is wider than the screen on purpose, and
      the layout audit in scripts/shots.mjs would otherwise report every logo
      past the edge as horizontal overflow. Scoped to this element so the check
      stays live everywhere else. */}
  {/* tabindex: the pause below is keyed on hover and focus, and until this was
      here the focus half could never fire — there is nothing focusable inside,
      and `role="img"` prunes the subtree from the accessibility tree anyway. So
      the rule read as though the strip could be stopped from the keyboard when
      only a mouse could stop it, which is the WCAG 2.2.2 mechanism the comment
      on it claims. The element takes focus itself instead. Its ring comes from
      the global `:where(a, button, [tabindex]):focus-visible`. */}
  <div
    class="marquee"
    role="img"
    aria-label={spoken}
    tabindex="0"
    data-bleed-ok
  >
    <div class="rail">
      {
        /* Two identical groups, which is what the seam needs and is separate
           from the doubling that used to sit inside a group and no longer does
           (see the note on `group`). The animation travels exactly one group
           width (-50% of the rail) and restarts, so the seam lands where the
           second group's first logo is already standing in the first's place. Each
           group carries the trailing gap itself — putting that gap on .rail
           instead would make one group width and -50% differ by half a gap,
           which is exactly the visible stutter this shape avoids. */
        [0, 1].map(() => (
          <div class="group">
            {group.map((b) => (
              <div class="lockup">
                <svg
                  class="mark"
                  viewBox={b.viewBox ?? '0 0 24 24'}
                  height={b.size}
                  width={b.size}
                  aria-hidden="true"
                  focusable="false"
                >
                  <path fill="currentColor" d={b.path} />
                </svg>
                <span class="name">{b.label}</span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* No padding: the strip is a band and the page owns the air around it. See
     the note in the frontmatter. */
  .backers {
    padding-block: 0;
  }

  /* Reference-designator type: the label comes with the row rather than
     leaving six logos to explain themselves. */
  .caption {
    margin: 0 0 1.25rem;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .marquee {
    /* No .wrap: the rail runs the full width of the content column. */
    max-width: var(--maxw);
    margin-inline: auto;
    overflow: hidden;
    /* Feathered ends, so logos arrive and leave rather than being cut off at a
       hard edge. Both properties, not just the standard one: WebKit still needs
       the prefix for mask-image on this. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }

  .rail {
    display: flex;
    width: max-content;
    /* Slow enough to read as a background texture rather than as something
       demanding to be watched: about 30px a second, or a logo width every four
       seconds. The strip sits inside the fold now, next to a terminal that is
       already animating, so it has to drift rather than travel — anything
       quicker and the two compete for the same glance. */
    animation: roll 80s linear infinite;
  }

  /* WCAG 2.2.2 wants a way to stop moving content, and it has to be operable
     without a pointer, so the rail stops on focus as well as hover — see the
     tabindex on .marquee, without which the second selector matched nothing.
     Reduced motion below is the fuller answer; this is the one for a reader who
     simply wants to look at a logo without chasing it. */
  .marquee:hover .rail,
  .marquee:focus-within .rail {
    animation-play-state: paused;
  }

  @keyframes roll {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .group {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding-right: 4rem; /* the seam's gap; see the note in the template */
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .mark {
    flex: none;
    display: block;
  }

  .name {
    font-size: 1.0625rem; /* 17px */
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  @media (max-width: 720px) {
    .caption {
      margin-bottom: 0.9rem;
      letter-spacing: 0.1em;
    }

    .group {
      gap: 2.5rem;
      padding-right: 2.5rem;
    }

    .name {
      font-size: 0.9375rem; /* 15px */
    }

    /* A phone is a fifth of the width, so the same pixel speed reads as a
       sprint. Slow it further to keep the strip calm. */
    .rail {
      animation-duration: 115s;
    }
  }

  /* Not merely a slower marquee: no marquee. The global reduce block clamps
     animation-duration, which would leave this scrolling in one frame, so the
     strip becomes what it should have been all along for these readers — a
     static, centred, wrapping row. One group is enough once nothing moves, and
     the second is the duplicate, so it goes. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
      padding-inline: 32px;
    }

    .rail {
      width: auto;
      animation: none;
      justify-content: center;
    }

    .group:last-child {
      display: none;
    }

    .group {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem 3rem;
      padding-right: 0;
    }

  }

  @media (prefers-reduced-motion: reduce) and (max-width: 720px) {
    .marquee {
      padding-inline: 22px;
    }
  }
</style>
