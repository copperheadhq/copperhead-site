---
import '../styles/global.css';
import { site, repo, links, siteCard } from '../config';

interface Props {
  /** Full <title>. Defaults to the home page title. */
  title?: string;
  description?: string;
  /** Site-root-relative path of this page, e.g. '/blog/'. Sets canonical + og:url. */
  path?: string;
  /** Extra JSON-LD appended after the SoftwareApplication node (blog posts, FAQ). */
  jsonLd?: Record<string, unknown>;
  /** 'article' for blog posts, so link unfurls read as posts rather than a product page. */
  ogType?: 'website' | 'article';
  /** Site-root-relative path of a page-specific 1200x630 share image. Defaults to the site card. */
  ogImage?: string;
  /** Alt text for the social share image. */
  ogImageAlt?: string;
  /** ISO date for article:published_time (blog posts only). */
  publishedTime?: string;
  /** Emit <meta name="robots" content="noindex">. The 404 page: Cloudflare
      serves dist/404.html with a 200 at /404 itself, and a 200 page titled
      "Page not found" that declares itself canonical is a textbook soft 404. */
  noindex?: boolean;
}

const {
  title = 'copperhead. Cursor for circuit boards.',
  description = 'An open-source AI agent that designs, documents and validates real PCBs from a prompt.',
  path = '/',
  jsonLd: extraJsonLd,
  ogType = 'website',
  ogImage: ogImagePath = siteCard,
  ogImageAlt = 'copperhead: an open-source AI agent for circuit board design',
  publishedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site).href;
const ogImage = new URL(ogImagePath, site).href;

// The product node stays on every page: it is the thing the whole site is about,
// and search engines get one consistent description of it wherever they land.
const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'copperhead',
  description:
    'An open-source AI agent that designs, documents and validates real PCBs from a prompt.',
  url: site,
  codeRepository: repo,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'Chouhan Industries', url: links.chouhan },
};

const jsonLd = extraJsonLd ? [appJsonLd, extraJsonLd] : appJsonLd;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    {/* Above the theme script, not down with the other <link>s: the script
        rewrites these, so they have to be in the DOM by the time it runs. The
        pair is media-scoped rather than a single tag, which gets the browser
        chrome onto the right theme with no script at all — data-scheme is how
        the script tells them apart once it does need to override. */}
    <meta
      name="theme-color"
      data-scheme="light"
      media="(prefers-color-scheme: light)"
      content="#FDFCFC"
    />
    <meta
      name="theme-color"
      data-scheme="dark"
      media="(prefers-color-scheme: dark)"
      content="#09090B"
    />

    {/* Theme, before anything paints.

        The stylesheet already themes the page off the OS preference on its own
        (global.css declares every token as light-dark() under `color-scheme:
        light dark`), so this runs only to honour an explicit choice the reader
        has made at the navbar toggle — and it has to run here, in the head and
        unbundled, because an override applied after first paint is a flash of
        the wrong theme.

        The whole model lives here rather than in the navbar so that the path
        taken before paint and the path taken on a click are the same three
        lines. Three states, not two: 'light', 'dark', and null for "follow the
        OS". Null writes no attribute, which is what keeps the page tracking the
        system preference live if the reader changes it mid-session. */}
    <script is:inline>
      window.__theme = {
        stored: function () {
          try {
            var t = localStorage.getItem('copperhead-theme');
            return t === 'light' || t === 'dark' ? t : null;
          } catch (e) {
            return null; /* private mode, or storage disabled */
          }
        },

        /* What the page is actually painted in right now, whether that came
           from a stored choice or from the OS. */
        resolved: function () {
          return (
            this.stored() ||
            (matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light')
          );
        },

        apply: function (mode) {
          var root = document.documentElement;
          if (mode) root.dataset.theme = mode;
          else delete root.dataset.theme;

          /* The two theme-color metas are media-scoped so that with no override
             the browser chrome follows the OS by itself. An override has to
             beat that, so the queries are swapped for `all` on the winner and
             `not all` on the loser; clearing back to null restores them. */
          var metas = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < metas.length; i++) {
            var scheme = metas[i].dataset.scheme;
            metas[i].media = !mode
              ? '(prefers-color-scheme: ' + scheme + ')'
              : mode === scheme
                ? 'all'
                : 'not all';
          }
        },

        set: function (mode) {
          try {
            if (mode) localStorage.setItem('copperhead-theme', mode);
            else localStorage.removeItem('copperhead-theme');
          } catch (e) {
            /* the choice just will not survive the session */
          }
          this.apply(mode);
        },
      };

      window.__theme.apply(window.__theme.stored());
    </script>

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-KGEWCR918W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-KGEWCR918W');
    </script>

    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* One face renders the whole page now, so it is the only one preloaded.
        Space Grotesk is a single variable file carrying 300-700, which is why
        dropping Plex removed two requests rather than adding one. */}
    <link
      rel="preload"
      href="/fonts/space-grotesk-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* The second preload earns its place by position rather than by volume:
        DM Sans sets the fixed bar, which is above the fold on every page and on
        screen before anything else is. Discovered from the stylesheet instead,
        it lands a round trip late and the bar swaps under the reader. */}
    <link
      rel="preload"
      href="/fonts/dm-sans-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* The 400 sets the blog's running text (--body in global.css). Preloaded
        with the 500 rather than discovered from the stylesheet, for the same
        reason: a body face that arrives a round trip late reflows the article
        under the reader. It costs 8.3 KB on pages that do not use it, which is
        the price of one preload tag over a per-page conditional. */}
    <link
      rel="preload"
      href="/fonts/dm-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="copperhead" />
    <meta property="og:locale" content="en_US" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@copperheadhq" />
    <meta name="twitter:creator" content="@copperheadhq" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
